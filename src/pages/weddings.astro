---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials, weddingFaqs } from '../data/site';
import { fleet, fleetImages } from '../data/fleet';
import { withBase } from '../utils/paths';
import weddingBannerBackground from '../assets/images/wedding/wedding-banner-bg.png';
import trolleyCoachPackageImage from '../assets/images/wedding/trolley-coach.png';
import trolleyInteriorExteriorImage from '../assets/images/wedding/trolley-interior-exterior.png';

const classicTrolley = fleet.find((vehicle) => vehicle.slug === 'classic-white-trolley');
if (!classicTrolley) throw new Error('Classic White Trolley fleet data is required for the wedding page.');

const weddingTestimonials = [testimonials[0], testimonials[1], testimonials[5]];
const trolleyQuoteHref = withBase(
  `/?vehicle=${encodeURIComponent(classicTrolley.quoteValue)}#getquote`,
);
const trolleyHref = withBase('/fleet/classic-white-trolley');
---

<BaseLayout
  title="Chicago Wedding Trolley Rental | ChiTown Trolley"
  description="Book a Chicago wedding trolley rental for the ceremony, photos and reception. Classic white trolley service for 30–36 guests across Chicagoland."
  image={fleetImages.trolley.classicExterior}
  hideCta={true}
>
  <!-- Full-width service hero -->
  <section
    class="whero"
    style={`background-image: url('${weddingBannerBackground.src}')`}
  >
    <div class="whero__overlay"></div>
    <div class="whero__content">
      <p class="whero__kicker">Wedding Trolley Transportation</p>
      <h1 class="whero__title">Chicago Wedding Trolley Rental</h1>
      <p class="whero__lead">
        A classic white trolley for the ceremony, photos, reception and every stop in between.
      </p>
      <div class="whero__actions">
        <a href={trolleyQuoteHref} class="btn-gold">Check Wedding Availability</a>
        <a href={trolleyHref} class="btn-ghost">View the Wedding Trolley</a>
      </div>
    </div>
  </section>

  <!-- Trolley and coach package -->
  <section class="wpackage" aria-labelledby="wedding-package-title">
    <div class="wpackage__inner wrap wrap-1140">
      <header class="wpackage__heading">
        <Eyebrow label="Wedding Package" mb={18} />
        <h2 id="wedding-package-title">Best-Selling Wedding Package</h2>
        <p>
          Keep your wedding party and guests moving together with one thoughtfully coordinated
          trolley and coach package.
        </p>
      </header>

      <div class="wpackage__card">
        <figure class="wpackage__media">
          <div class="wpackage__visual">
            <Image
              src={trolleyCoachPackageImage}
              alt="White trolley and white coach bus parked together at a wedding venue"
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 950px) calc(100vw - 40px), (max-width: 1200px) 56vw, 630px"
              format="webp"
              quality={84}
              loading="lazy"
              decoding="async"
              class="wpackage__image"
            />
            <span class="wpackage__badge">Most Popular</span>
          </div>
          <figcaption>
            <span>Trolley + Coach</span>
            <strong>Two vehicles. One seamless celebration.</strong>
          </figcaption>
        </figure>

        <div class="wpackage__copy">
          <p class="wpackage__kicker">Package at a glance</p>

          <div class="wpackage__vehicles">
            <div class="wpackage__vehicle">
              <span class="wpackage__vehicleMark" aria-hidden="true">T</span>
              <div class="wpackage__vehicleCopy">
                <h3>Classic White Trolley</h3>
                <p>Up to 30 passengers</p>
              </div>
              <p class="wpackage__duration"><strong>5</strong><span>hours</span></p>
            </div>

            <div class="wpackage__vehicle">
              <span class="wpackage__vehicleMark" aria-hidden="true">C</span>
              <div class="wpackage__vehicleCopy">
                <h3>Coach Bus</h3>
                <p>Up to 50 guests</p>
              </div>
              <p class="wpackage__duration"><strong>8</strong><span>hours</span></p>
            </div>
          </div>

          <div class="rule-gold wpackage__rule"></div>
          <h3 class="wpackage__includesTitle">Everything your day needs</h3>
          <ul class="wpackage__features">
            <li><strong>Guest shuttle timing</strong><span>Recommended service from 4:00 p.m. to midnight</span></li>
            <li><strong>Flexible itinerary</strong><span>Unlimited scheduled stops and mileage</span></li>
            <li><strong>Comfort included</strong><span>Climate control, Bluetooth audio, comfortable seating and luggage storage</span></li>
            <li><strong>Professional service</strong><span>Experienced chauffeurs for both vehicles</span></li>
          </ul>

          <div class="wpackage__actions">
            <button
              type="button"
              class="btn-gold"
              data-package-modal-open
              aria-haspopup="dialog"
              aria-controls="wedding-package-dialog"
            >Check Availability</button>
            <p>Share your date and itinerary—we’ll confirm the details.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <dialog
    class="packageModal"
    id="wedding-package-dialog"
    data-package-modal
    aria-labelledby="wedding-package-dialog-title"
  >
    <div class="packageModal__panel">
      <button
        type="button"
        class="packageModal__close"
        data-package-modal-close
        aria-label="Close wedding package availability form"
      >×</button>
      <p class="packageModal__kicker">Best-Selling Wedding Package</p>
      <h2 id="wedding-package-dialog-title">Check Wedding Package Availability</h2>
      <p class="packageModal__intro">
        Share your wedding details and we’ll confirm availability for the trolley and coach package.
      </p>

      <form
        class="packageForm"
        name="quote-request"
        method="POST"
        data-netlify="true"
        data-netlify-form="true"
        data-netlify-honeypot="bot-field"
        data-package-form
      >
        <input type="hidden" name="form-name" value="quote-request" />
        <input type="hidden" name="notification-form" value="wedding-quote-request" />
        <input type="hidden" name="type" value="Wedding" />
        <input type="hidden" name="hours" value="Trolley: 5 hours; Coach Bus: 8 hours" />
        <input type="hidden" name="vehicle" value="Best-Selling Wedding Package" />
        <p class="netlify-honeypot" aria-hidden="true">
          <label>
            Do not fill this out:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <label class="field">
          <span class="field__label">Full Name</span>
          <input required name="name" type="text" autocomplete="name" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Email Address</span>
          <input required name="email" type="email" autocomplete="email" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Phone Number</span>
          <input required name="phone" type="tel" autocomplete="tel" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Wedding Date</span>
          <input required name="date" type="date" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Estimated Guest Count</span>
          <input required name="passengers" type="number" min="1" inputmode="numeric" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Preferred Trolley Pickup Time</span>
          <input name="time" type="time" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Pickup Location</span>
          <input name="pickup" type="text" autocomplete="street-address" class="field__control" />
        </label>
        <label class="field">
          <span class="field__label">Reception or Final Destination</span>
          <input name="dropoff" type="text" class="field__control" />
        </label>
        <label class="field packageForm__full">
          <span class="field__label">Additional Details</span>
          <textarea
            name="message"
            rows="3"
            placeholder="Hotels, venues, shuttle timing or other stops"
            class="field__control"
          ></textarea>
        </label>
        <div class="packageForm__actions">
          <button type="submit" class="btn-gold">Check Availability</button>
        </div>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </dialog>

  <!-- Wedding-day route -->
  <section class="wroute">
    <div class="wrap wrap-1140">
      <div class="wroute__intro">
        <Eyebrow label="Your Wedding Day" align="left" single mb={16} />
        <h2>One trolley for every stop</h2>
        <p>
          Keep the wedding party together from the hotel and ceremony to photo locations and the
          reception. Share your timeline and planned stops, and we will help coordinate a route
          that keeps the day moving.
        </p>
      </div>

      <ol class="wroute__timeline" aria-label="Wedding trolley route">
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Hotel Pickup</h3>
          <p>Begin with one coordinated pickup for the couple, wedding party or immediate family.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Ceremony</h3>
          <p>Arrive together and keep the group on one schedule before the ceremony begins.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Photo Stops</h3>
          <p>Plan time for portraits at approved locations between the ceremony and reception.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Reception</h3>
          <p>Finish at the reception venue or continue with scheduled return transportation.</p>
        </li>
      </ol>

      <nav class="wroute__guides" aria-label="Wedding transportation planning guides">
        <a href={withBase('/guides/how-many-guests-fit-in-a-trolley')}>
          Read the wedding transportation sizing guide
        </a>
        <a href={withBase('/guides/wedding-day-shuttle-logistics-timeline')}>
          Read the wedding shuttle timeline guide
        </a>
        <a href={withBase('/guides/chicago-trolley-friendly-wedding-venues')}>
          Browse trolley-friendly Chicago wedding venues
        </a>
      </nav>
    </div>
  </section>

  <!-- Classic trolley experience -->
  <section class="wtrolley">
    <div class="wtrolley__inner wrap wrap-1140">
      <div class="wtrolley__visual">
        <Image
          src={trolleyInteriorExteriorImage}
          alt="Interior seating and exterior view of the classic white trolley"
          widths={[600, 900, 1200]}
          sizes="(max-width: 1200px) 52vw, 620px"
          format="webp"
          quality={86}
          class="wtrolley__img"
          loading="lazy"
        />
        <p class="wtrolley__caption">The cabin keeps the wedding party together between stops.</p>
      </div>

      <div class="wtrolley__copy">
        <Eyebrow label="The Classic White Trolley" align="left" single mb={16} />
        <h2>A white wedding trolley made for the moments between venues</h2>
        <figure class="wtrolley__mobileImage">
          <Image
            src={trolleyInteriorExteriorImage}
            alt="Interior seating and exterior view of the classic white trolley"
            widths={[480, 720, 950]}
            sizes="(max-width: 640px) calc(100vw - 60px), calc(100vw - 104px)"
            format="webp"
            quality={84}
            loading="lazy"
          />
          <figcaption>The cabin keeps the wedding party together between stops.</figcaption>
        </figure>
        <p>
          Our classic white trolley seats 30–36 passengers and gives the wedding party one
          comfortable, coordinated ride throughout the day. The bright exterior, arched windows
          and distinctive details also make it a natural part of the wedding photographs.
        </p>
        <ul class="wtrolley__features">
          <li>Seating for 30–36 passengers</li>
          <li>Traditional forward-facing seating</li>
          <li>Rear balcony for photos</li>
          <li>Bluetooth audio</li>
          <li>Heat and air conditioning</li>
          <li>Multiple-stop itinerary planning</li>
        </ul>
        <a href={trolleyHref} class="btn-gold">Explore the Classic White Trolley</a>
      </div>
    </div>
  </section>

  <!-- Wedding testimonials -->
  <section class="wreviews">
    <div class="wrap wrap-1000">
      <div class="wreviews__head">
        <Eyebrow label="Wedding Reviews" align="left" single mb={16} />
        <h2>What Chicago couples remember most</h2>
      </div>
      <div class="wreviews__grid">
        {weddingTestimonials.map((testimonial, index) => (
          <blockquote class:list={['wreview', { 'wreview--featured': index === 0 }]}>
            <span class="wreview__mark" aria-hidden="true">“</span>
            <p>{testimonial.quote}</p>
            <footer>{testimonial.name}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Wedding FAQs -->
  <section class="wfaq" aria-labelledby="wedding-faq-title">
    <div class="wrap wrap-860">
      <Eyebrow label="Wedding Trolley Questions" mb={16} />
      <h2 id="wedding-faq-title">Planning your wedding trolley rental</h2>
      <div class="wfaq__list" data-wedding-faq>
        {weddingFaqs.map((item, index) => {
          const buttonId = `wedding-faq-button-${index + 1}`;
          const panelId = `wedding-faq-panel-${index + 1}`;
          return (
            <div class="wfaq__item">
              <button
                id={buttonId}
                type="button"
                class="wfaq__head"
                aria-expanded="false"
                aria-controls={panelId}
                data-wedding-faq-toggle
              >
                <span>{item.q}</span>
                <span class="wfaq__chevron" aria-hidden="true"></span>
              </button>
              <div
                id={panelId}
                class="wfaq__panel"
                role="region"
                aria-labelledby={buttonId}
              >
                <div class="wfaq__body" inert>
                  <p>{item.a}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Wedding quote CTA -->
  <div class="wedding-final">
    <CtaBand
      title="Reserve your Chicago wedding trolley"
      sub="Share your date, guest count and itinerary to check availability for your wedding day."
      ctaLabel="Wedding Trolley Quote"
      ctaHref={trolleyQuoteHref}
    />
  </div>
</BaseLayout>

<style>
  :where(.whero, .wroute, .wtrolley, .wpackage, .wreviews, .wfaq) h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.08;
    color: var(--ink);
  }

  /* Hero */
  .whero {
    position: relative;
    height: 315px;
    overflow: hidden;
    background-color: #17140f;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
  .whero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 10, 7, .94) 0%,
        rgba(12, 10, 7, .82) 36%,
        rgba(12, 10, 7, .48) 62%,
        rgba(12, 10, 7, .1) 100%
      ),
      linear-gradient(0deg, rgba(12, 10, 7, .2), transparent 65%);
  }
  .whero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 15px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 30px) clamp(24px, 6vw, 96px) 0;
    animation: fadeInUp 1.1s cubic-bezier(.22, .6, .2, 1) both;
  }
  .whero__kicker {
    margin: 0;
    color: var(--gold-light);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: .34em;
    text-transform: uppercase;
  }
  .whero__title {
    margin: 0;
    color: #fff;
    font-family: var(--serif);
    font-size: clamp(36px, 5.4vw, 70px);
    font-weight: 500;
    line-height: 1.1;
    text-shadow: 0 2px 24px rgba(0, 0, 0, .42);
  }
  .whero__lead {
    max-width: 46ch;
    margin: 0;
    color: rgba(253, 252, 250, .9);
    font-size: 16.5px;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: .02em;
    text-shadow: 0 2px 16px rgba(0, 0, 0, .35);
  }
  .whero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2px;
  }
  .whero__actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .whero__actions .btn-ghost {
    border-color: rgba(212, 175, 106, .78);
    background: rgba(10, 8, 6, .2);
    color: var(--paper);
  }
  .whero__actions .btn-ghost:hover {
    border-color: var(--gold-light);
    background: rgba(253, 252, 250, .1);
    color: #fff;
  }

  /* Route */
  .wroute { padding: 94px 28px 84px; background: var(--paper); }
  .wroute__intro { max-width: 780px; }
  .wroute__intro p {
    max-width: 66ch;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
  }
  .wroute__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin: 58px 0 0;
    padding: 0;
    list-style: none;
  }
  .wroute__timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    right: 10%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-dark), var(--line));
  }
  .wroute__timeline li { position: relative; padding: 32px 20px 0 0; }
  .wroute__marker {
    position: absolute;
    top: 2px;
    left: 0;
    z-index: 1;
    width: 13px;
    height: 13px;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--gold-dark);
    box-shadow: 0 0 0 1px var(--gold-dark);
  }
  .wroute__timeline h3 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
  }
  .wroute__timeline p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
  }
  .wroute__guides {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 52px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .wroute__guides a {
    color: var(--gold-deep);
    font-size: 13px;
    line-height: 1.5;
    text-underline-offset: 4px;
  }

  /* Classic trolley */
  .wtrolley { padding: 96px 28px; background: var(--cream); }
  .wtrolley__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, .88fr);
    align-items: center;
    gap: clamp(48px, 7vw, 88px);
  }
  .wtrolley__visual { position: relative; padding: 0 32px 38px 0; }
  .wtrolley__visual::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: 72%;
    height: 70%;
    border: 1px solid var(--gold);
  }
  .wtrolley__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 20px 52px rgba(26, 26, 26, .12);
  }
  .wtrolley__caption {
    position: relative;
    z-index: 1;
    max-width: 52ch;
    margin: 16px 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
  }
  .wtrolley__mobileImage { display: none; }
  .wtrolley__copy > p {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1.8;
  }
  .wtrolley__features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 22px;
    margin: 28px 0 34px;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .wtrolley__features li {
    position: relative;
    padding: 13px 0 13px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.5;
  }
  .wtrolley__features li::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 0;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--gold-dark);
  }

  /* Trolley + coach package */
  .wpackage {
    padding: 32px 28px;
    background:
      radial-gradient(circle at 12% 18%, rgba(212, 175, 106, .09), transparent 28%),
      var(--cream);
  }
  .wpackage__heading {
    max-width: 720px;
    margin: 0 auto clamp(38px, 5vw, 56px);
    text-align: center;
  }
  .wpackage__heading > p {
    max-width: 620px;
    margin: 18px auto 0;
    color: var(--muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.7;
  }
  .wpackage__card {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, .92fr);
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 24px 60px rgba(47, 36, 20, .1);
  }
  .wpackage__media {
    display: flex;
    min-width: 0;
    margin: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(22px, 3vw, 36px);
    border-right: 1px solid var(--line-2);
    background: #f1eadf;
  }
  .wpackage__visual {
    position: relative;
    overflow: hidden;
    border-radius: 9px;
    box-shadow: 0 16px 34px rgba(35, 28, 17, .13);
  }
  .wpackage__visual :global(picture) { display: block; }
  .wpackage__visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .wpackage__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 12px 7px;
    border-radius: 999px;
    background: rgba(253, 252, 250, .94);
    color: var(--gold-deep);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .2em;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 0 5px 16px rgba(26, 26, 26, .12);
  }
  .wpackage__media figcaption {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 2px 0;
  }
  .wpackage__media figcaption span {
    flex: none;
    color: var(--gold-deep);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
  }
  .wpackage__media figcaption strong {
    max-width: 280px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    line-height: 1.25;
    text-align: right;
  }
  .wpackage__copy {
    display: flex;
    min-width: 0;
