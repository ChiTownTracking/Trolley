<script>
  const packageModalOpen = document.querySelector<HTMLButtonElement>('[data-package-modal-open]');
  const packageModal = document.querySelector<HTMLDialogElement>('[data-package-modal]');
  const packageModalClose = packageModal?.querySelector<HTMLButtonElement>('[data-package-modal-close]');
  const packageForm = packageModal?.querySelector<HTMLFormElement>('[data-package-form]');

  packageModalOpen?.addEventListener('click', () => {
    const status = packageForm?.querySelector<HTMLElement>('[data-form-status]');
    if (status) {
      status.textContent = '';
      delete status.dataset.state;
    }
    packageModal?.showModal();
    document.documentElement.classList.add('package-modal-open');
  });

  packageModalClose?.addEventListener('click', () => packageModal?.close());

  packageModal?.addEventListener('click', (event) => {
    if (event.target === packageModal) packageModal.close();
  });

  packageModal?.addEventListener('close', () => {
    document.documentElement.classList.remove('package-modal-open');
  });

  const weddingFaq = document.querySelector<HTMLElement>('[data-wedding-faq]');
  if (weddingFaq) {
    const items = Array.from(weddingFaq.querySelectorAll<HTMLElement>('.wfaq__item'));
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item
        .querySelector('[data-wedding-faq-toggle]')
        ?.setAttribute('aria-expanded', String(open));
      const body = item.querySelector<HTMLElement>('.wfaq__body');
      if (body) body.inert = !open;
    };

    items.forEach((item) => {
      item
        .querySelector<HTMLButtonElement>('[data-wedding-faq-toggle]')
        ?.addEventListener('click', () => {
          const wasOpen = item.classList.contains('is-open');
          items.forEach((otherItem) => setOpen(otherItem, false));
          if (!wasOpen) setOpen(item, true);
        });
      setOpen(item, false);
    });
  }
</script>
