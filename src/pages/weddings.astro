---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials, weddingFaqs } from '../data/site';
import { fleet, fleetImages } from '../data/fleet';
import { withBase } from '../utils/paths';
import weddingBannerBackground from '../assets/images/wedding/wedding-banner-bg.png';
import trolleyCoachPackageImage from '../assets/images/wedding/trolley-coach.png';
import trolleyInteriorExteriorImage from '../assets/images/wedding/trolley-interior-exterior.png';

const classicTrolley = fleet.find((vehicle) => vehicle.slug === 'classic-white-trolley');
if (!classicTrolley) throw new Error('Classic White Trolley fleet data is required for the wedding page.');

const weddingTestimonials = [testimonials[0], testimonials[1], testimonials[5]];
const trolleyQuoteHref = withBase(
  `/?vehicle=${encodeURIComponent(classicTrolley.quoteValue)}#getquote`,
);
const packageQuoteHref = withBase(
  `/?vehicle=${encodeURIComponent('Trolley + Coach Package')}#getquote`,
);
const trolleyHref = withBase('/fleet/classic-white-trolley');
---

<BaseLayout
  title="Chicago Wedding Trolley Rental | ChiTown Trolley"
  description="Book a Chicago wedding trolley rental for the ceremony, photos and reception. Classic white trolley service for 30–36 guests across Chicagoland."
  image={fleetImages.trolley.classicExterior}
  hideCta={true}
>
  <!-- Full-width service hero -->
  <section
    class="whero"
    style={`background-image: url('${weddingBannerBackground.src}')`}
  >
    <div class="whero__overlay"></div>
    <div class="whero__content">
      <p class="whero__kicker">Wedding Trolley Transportation</p>
      <h1 class="whero__title">Chicago Wedding Trolley Rental</h1>
      <p class="whero__lead">
        A classic white trolley for the ceremony, photos, reception and every stop in between.
      </p>
      <div class="whero__actions">
        <a href={trolleyQuoteHref} class="btn-gold">Check Wedding Availability</a>
        <a href={trolleyHref} class="btn-ghost">View the Wedding Trolley</a>
      </div>
    </div>
  </section>

  <!-- Trolley and coach package -->
  <section class="wpackage">
    <div class="wpackage__inner wrap wrap-1140">
      <div class="wpackage__copy">
        <Eyebrow label="Wedding Package" align="left" single mb={16} />
        <h2>The trolley for the wedding party, a coach for your guests</h2>
        <div class="wpackage__mobileImage">
          <Image
            src={trolleyCoachPackageImage}
            alt="White trolley and white coach bus parked together"
            widths={[480, 720, 950]}
            sizes="(max-width: 640px) calc(100vw - 60px), calc(100vw - 104px)"
            format="webp"
            quality={84}
            loading="lazy"
          />
        </div>
        <p>
          Pair the classic white trolley with a super coach when the wedding party and guest list
          require separate vehicles. The trolley can carry the couple and wedding party while the
          coach coordinates hotel pickups, ceremony transfers and reception transportation for up
          to 57 guests.
        </p>
        <p>
          Both vehicles can follow one coordinated itinerary, helping guests arrive on schedule
          without relying on separate cars or unfamiliar parking.
        </p>
        <div class="wpackage__actions">
          <a href={packageQuoteHref} class="btn-gold">Ask About Wedding Transportation Packages</a>
          <a href={withBase('/fleet')} class="link-gold">View the full transportation fleet →</a>
        </div>
      </div>

      <div class="wpackage__visual">
        <figure class="wpackage__trolley">
          <Image
            src={fleetImages.trolley.classicExterior}
            alt="Trolley viewed from the front with its open platform"
            widths={[480, 720, 900]}
            sizes="(max-width: 820px) 100vw, 48vw"
            format="webp"
            quality={86}
            loading="lazy"
          />
          <figcaption>
            <h3>Wedding Party Trolley</h3>
            <p>30–36 passengers</p>
          </figcaption>
        </figure>
        <figure class="wpackage__coach">
          <Image
            src={fleetImages.coach.exterior1}
            alt="Super coach bus prepared for evening guest transportation"
            widths={[320, 480]}
            sizes="(max-width: 820px) 70vw, 22vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
          <figcaption>
            <h3>Guest Coach Transportation</h3>
            <p>Up to 57 guests</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Wedding-day route -->
  <section class="wroute">
    <div class="wrap wrap-1140">
      <div class="wroute__intro">
        <Eyebrow label="Your Wedding Day" align="left" single mb={16} />
        <h2>One trolley for every stop</h2>
        <p>
          Keep the wedding party together from the hotel and ceremony to photo locations and the
          reception. Share your timeline and planned stops, and we will help coordinate a route
          that keeps the day moving.
        </p>
      </div>

      <ol class="wroute__timeline" aria-label="Wedding trolley route">
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Hotel Pickup</h3>
          <p>Begin with one coordinated pickup for the couple, wedding party or immediate family.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Ceremony</h3>
          <p>Arrive together and keep the group on one schedule before the ceremony begins.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Photo Stops</h3>
          <p>Plan time for portraits at approved locations between the ceremony and reception.</p>
        </li>
        <li>
          <span class="wroute__marker" aria-hidden="true"></span>
          <h3>Reception</h3>
          <p>Finish at the reception venue or continue with scheduled return transportation.</p>
        </li>
      </ol>

      <nav class="wroute__guides" aria-label="Wedding transportation planning guides">
        <a href={withBase('/guides/how-many-guests-fit-in-a-trolley')}>
          Read the wedding transportation sizing guide
        </a>
        <a href={withBase('/guides/wedding-day-shuttle-logistics-timeline')}>
          Read the wedding shuttle timeline guide
        </a>
        <a href={withBase('/guides/chicago-trolley-friendly-wedding-venues')}>
          Browse trolley-friendly Chicago wedding venues
        </a>
      </nav>
    </div>
  </section>

  <!-- Classic trolley experience -->
  <section class="wtrolley">
    <div class="wtrolley__inner wrap wrap-1140">
      <div class="wtrolley__visual">
        <Image
          src={trolleyInteriorExteriorImage}
          alt="Interior seating and exterior view of the classic white trolley"
          widths={[600, 900, 1200]}
          sizes="(max-width: 1200px) 52vw, 620px"
          format="webp"
          quality={86}
          class="wtrolley__img"
          loading="lazy"
        />
        <p class="wtrolley__caption">The cabin keeps the wedding party together between stops.</p>
      </div>

      <div class="wtrolley__copy">
        <Eyebrow label="The Classic White Trolley" align="left" single mb={16} />
        <h2>A white wedding trolley made for the moments between venues</h2>
        <figure class="wtrolley__mobileImage">
          <Image
            src={trolleyInteriorExteriorImage}
            alt="Interior seating and exterior view of the classic white trolley"
            widths={[480, 720, 950]}
            sizes="(max-width: 640px) calc(100vw - 60px), calc(100vw - 104px)"
            format="webp"
            quality={84}
            loading="lazy"
          />
          <figcaption>The cabin keeps the wedding party together between stops.</figcaption>
        </figure>
        <p>
          Our classic white trolley seats 30–36 passengers and gives the wedding party one
          comfortable, coordinated ride throughout the day. The bright exterior, arched windows
          and distinctive details also make it a natural part of the wedding photographs.
        </p>
        <ul class="wtrolley__features">
          <li>Seating for 30–36 passengers</li>
          <li>Traditional forward-facing seating</li>
          <li>Rear balcony for photos</li>
          <li>Bluetooth audio</li>
          <li>Heat and air conditioning</li>
          <li>Multiple-stop itinerary planning</li>
        </ul>
        <a href={trolleyHref} class="btn-gold">Explore the Classic White Trolley</a>
      </div>
    </div>
  </section>

  <!-- Wedding testimonials -->
  <section class="wreviews">
    <div class="wrap wrap-1000">
      <div class="wreviews__head">
        <Eyebrow label="Wedding Reviews" align="left" single mb={16} />
        <h2>What Chicago couples remember most</h2>
      </div>
      <div class="wreviews__grid">
        {weddingTestimonials.map((testimonial, index) => (
          <blockquote class:list={['wreview', { 'wreview--featured': index === 0 }]}>
            <span class="wreview__mark" aria-hidden="true">“</span>
            <p>{testimonial.quote}</p>
            <footer>{testimonial.name}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Wedding FAQs -->
  <section class="wfaq" aria-labelledby="wedding-faq-title">
    <div class="wrap wrap-860">
      <Eyebrow label="Wedding Trolley Questions" mb={16} />
      <h2 id="wedding-faq-title">Planning your wedding trolley rental</h2>
      <div class="wfaq__list" data-wedding-faq>
        {weddingFaqs.map((item, index) => {
          const buttonId = `wedding-faq-button-${index + 1}`;
          const panelId = `wedding-faq-panel-${index + 1}`;
          return (
            <div class="wfaq__item">
              <button
                id={buttonId}
                type="button"
                class="wfaq__head"
                aria-expanded="false"
                aria-controls={panelId}
                data-wedding-faq-toggle
              >
                <span>{item.q}</span>
                <span class="wfaq__chevron" aria-hidden="true"></span>
              </button>
              <div
                id={panelId}
                class="wfaq__panel"
                role="region"
                aria-labelledby={buttonId}
              >
                <div class="wfaq__body" inert>
                  <p>{item.a}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Wedding quote CTA -->
  <div class="wedding-final">
    <CtaBand
      title="Reserve your Chicago wedding trolley"
      sub="Share your date, guest count and itinerary to check availability for your wedding day."
      ctaLabel="Wedding Trolley Quote"
      ctaHref={trolleyQuoteHref}
    />
  </div>
</BaseLayout>

<style>
  :where(.whero, .wroute, .wtrolley, .wpackage, .wreviews, .wfaq) h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.08;
    color: var(--ink);
  }

  /* Hero */
  .whero {
    position: relative;
    height: 315px;
    overflow: hidden;
    background-color: #17140f;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
  .whero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 10, 7, .94) 0%,
        rgba(12, 10, 7, .82) 36%,
        rgba(12, 10, 7, .48) 62%,
        rgba(12, 10, 7, .1) 100%
      ),
      linear-gradient(0deg, rgba(12, 10, 7, .2), transparent 65%);
  }
  .whero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 15px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 30px) clamp(24px, 6vw, 96px) 0;
    animation: fadeInUp 1.1s cubic-bezier(.22, .6, .2, 1) both;
  }
  .whero__kicker {
    margin: 0;
    color: var(--gold-light);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: .34em;
    text-transform: uppercase;
  }
  .whero__title {
    margin: 0;
    color: #fff;
    font-family: var(--serif);
    font-size: clamp(36px, 5.4vw, 70px);
    font-weight: 500;
    line-height: 1.1;
    text-shadow: 0 2px 24px rgba(0, 0, 0, .42);
  }
  .whero__lead {
    max-width: 46ch;
    margin: 0;
    color: rgba(253, 252, 250, .9);
    font-size: 16.5px;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: .02em;
    text-shadow: 0 2px 16px rgba(0, 0, 0, .35);
  }
  .whero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2px;
  }
  .whero__actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .whero__actions .btn-ghost {
    border-color: rgba(212, 175, 106, .78);
    background: rgba(10, 8, 6, .2);
    color: var(--paper);
  }
  .whero__actions .btn-ghost:hover {
    border-color: var(--gold-light);
    background: rgba(253, 252, 250, .1);
    color: #fff;
  }

  /* Route */
  .wroute { padding: 94px 28px 84px; background: var(--paper); }
  .wroute__intro { max-width: 780px; }
  .wroute__intro p {
    max-width: 66ch;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
  }
  .wroute__timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin: 58px 0 0;
    padding: 0;
    list-style: none;
  }
  .wroute__timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    right: 10%;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-dark), var(--line));
  }
  .wroute__timeline li { position: relative; padding: 32px 20px 0 0; }
  .wroute__marker {
    position: absolute;
    top: 2px;
    left: 0;
    z-index: 1;
    width: 13px;
    height: 13px;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--gold-dark);
    box-shadow: 0 0 0 1px var(--gold-dark);
  }
  .wroute__timeline h3 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 600;
  }
  .wroute__timeline p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
  }
  .wroute__guides {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 52px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .wroute__guides a {
    color: var(--gold-deep);
    font-size: 13px;
    line-height: 1.5;
    text-underline-offset: 4px;
  }

  /* Classic trolley */
  .wtrolley { padding: 96px 28px; background: var(--cream); }
  .wtrolley__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, .88fr);
    align-items: center;
    gap: clamp(48px, 7vw, 88px);
  }
  .wtrolley__visual { position: relative; padding: 0 32px 38px 0; }
  .wtrolley__visual::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: 72%;
    height: 70%;
    border: 1px solid var(--gold);
  }
  .wtrolley__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 20px 52px rgba(26, 26, 26, .12);
  }
  .wtrolley__caption {
    position: relative;
    z-index: 1;
    max-width: 52ch;
    margin: 16px 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
  }
  .wtrolley__mobileImage { display: none; }
  .wtrolley__copy > p {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1.8;
  }
  .wtrolley__features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 22px;
    margin: 28px 0 34px;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .wtrolley__features li {
    position: relative;
    padding: 13px 0 13px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.5;
  }
  .wtrolley__features li::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 0;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--gold-dark);
  }

  /* Trolley + coach package */
  .wpackage { padding: 64px 28px; background: var(--cream); }
  .wpackage__inner {
    display: grid;
    grid-template-columns: minmax(340px, .88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(48px, 7vw, 90px);
  }
  .wpackage__copy > p {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1.8;
  }
  .wpackage__copy > p + p { margin-top: 16px; }
  .wpackage__mobileImage { display: none; }
  .wpackage__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-top: 32px;
  }
  .wpackage__actions .btn-gold { text-align: center; }
  .wpackage__visual {
    display: grid;
    grid-template-columns: 1fr .54fr;
    align-items: end;
    gap: 16px;
  }
  .wpackage__visual figure { margin: 0; }
  .wpackage__visual :global(picture) { display: block; }
  .wpackage__visual :global(img) { width: 100%; height: auto; display: block; }
  .wpackage__trolley :global(img) {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    object-fit: cover;
  }
  .wpackage__coach { margin-bottom: 18px !important; }
  .wpackage__coach :global(img) {
    aspect-ratio: 4 / 3;
    border-radius: 5px;
    object-fit: cover;
  }
  .wpackage__visual figcaption {
    padding: 15px 0 0;
  }
  .wpackage__visual h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.2;
  }
  .wpackage__visual figcaption p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  /* Testimonials */
  .wreviews { padding: 94px 28px; background: var(--paper); }
  .wreviews__head { max-width: 680px; margin-bottom: 46px; }
  .wreviews__grid {
    display: grid;
    grid-template-columns: 1.25fr .875fr .875fr;
    gap: 18px;
  }
  .wreview {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 34px 30px 30px;
    border: 1px solid var(--line);
    background: var(--cream);
  }
  .wreview--featured { background: var(--ink); border-color: var(--ink); }
  .wreview__mark {
    display: block;
    height: 30px;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 52px;
    line-height: .8;
  }
  .wreview p {
    margin: 16px 0 26px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 18px;
    font-style: italic;
    line-height: 1.55;
  }
  .wreview--featured p { color: var(--paper); font-size: 21px; }
  .wreview footer {
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .wreview--featured footer { color: rgba(253, 252, 250, .66); }

  /* FAQs */
  .wfaq { padding: 94px 28px 100px; background: var(--cream); }
  .wfaq > .wrap > h2 { margin-bottom: 38px; text-align: center; }
  .wfaq__list { margin: 0 auto; }
  .wfaq__item { border-top: 1px solid var(--line-2); }
  .wfaq__item:last-child { border-bottom: 1px solid var(--line-2); }
  .wfaq__head {
    width: 100%;
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 4px;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
  }
  .wfaq__head span:first-child { flex: 1; }
  .wfaq__head:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: 4px; }
  .wfaq__chevron {
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 1.5px solid var(--gold-deep);
    border-bottom: 1.5px solid var(--gold-deep);
    transform: translateY(-2px) rotate(45deg);
    transition: transform .3s ease;
  }
  .wfaq__item.is-open .wfaq__chevron { transform: translateY(2px) rotate(-135deg); }
  .wfaq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .35s ease;
  }
  .wfaq__item.is-open .wfaq__panel { grid-template-rows: 1fr; }
  .wfaq__body { min-height: 0; overflow: hidden; }
  .wfaq__body p {
    max-width: 68ch;
    margin: 0;
    padding: 0 4px 26px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
  }

  .wedding-final :global(.cta-band) {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1024px) {
    .wroute__timeline { gap: 18px; }
    .wreviews__grid { grid-template-columns: 1fr 1fr; }
    .wreview--featured { grid-column: 1 / 3; }
  }

  @media (max-width: 950px) {
    .wtrolley__inner { grid-template-columns: 1fr; }
    .wtrolley__copy {
      width: 100%;
      max-width: 880px;
      margin-inline: auto;
    }
    .wtrolley__visual { display: none; }
    .wtrolley__mobileImage {
      display: block;
      margin: 28px 0 0;
    }
    .wtrolley__mobileImage :global(picture) { display: block; }
    .wtrolley__mobileImage :global(img) {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
    }
    .wtrolley__mobileImage figcaption {
      margin-top: 14px;
      color: var(--muted);
      font-family: var(--serif);
      font-size: 15px;
      font-style: italic;
      line-height: 1.5;
    }
    .wpackage__inner { grid-template-columns: 1fr; }
    .wpackage__copy {
      width: 100%;
      max-width: 880px;
      margin-inline: auto;
    }
    .wpackage__mobileImage {
