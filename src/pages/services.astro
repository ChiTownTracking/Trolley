---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedServiceRow from '../components/FeaturedServiceRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { fleetImages } from '../data/fleet';
import { withBase } from '../utils/paths';
import servicesBannerBackground from '../assets/images/services/services-banner-bg.png';

const featuredServices = [
  {
    id: 'corporate-events',
    eyebrow: 'Corporate Events',
    title: 'Keep the team moving on one clear schedule',
    body:
      'Meetings, conferences and company celebrations run more smoothly when every passenger follows one coordinated plan. Arrange hotel and venue transfers around the day’s schedule, with pickup details and group timing organized before anyone boards.',
    image: fleetImages.trolley.classicExterior,
    imageAlt: 'Classic white trolley parked for private group transportation',
    benefits: [
      'Meetings, conferences and company events',
      'Hotel and venue transfers',
      'Coordinated pickup and group timing',
    ],
    ctaLabel: 'Explore Corporate Transportation',
    ctaHref: '/#getquote',
  },
  {
    id: 'proms-and-homecomings',
    eyebrow: 'Proms & Homecomings',
    title: 'A polished arrival for the big night',
    body:
      'Keep friends together in one memorable vehicle for prom or homecoming, with pickup and return details planned around the evening. Parents and organizers can share the addresses, timing and group size in advance so the transportation fits the event schedule.',
    image: fleetImages.trolley.t4ExteriorFront,
    imageAlt: 'Front view of the T4 classic white trolley before a formal event',
    benefits: [
      'One vehicle for the group',
      'Coordinated pickup and return',
      'Planning details for parents or organizers',
    ],
    ctaLabel: 'Plan Prom or Homecoming Transportation',
    ctaHref: '/#getquote',
  },
  {
    id: 'quinceaneras',
    eyebrow: 'Quinceañeras',
    title: 'Transportation that stays with the rhythm of the celebration',
    body:
      'Keep family members and the court moving together between the ceremony, photo locations and reception. A clear itinerary helps coordinate each stop while giving the celebration a polished ride that stays in step with the timing of the day.',
    image: fleetImages.trolley.t4Interior1,
    imageAlt: 'Passenger seating inside the T4 classic white trolley',
    benefits: [
      'Family and court transportation',
      'Ceremony, photos and reception stops',
      'Coordinated timing throughout the day',
    ],
    ctaLabel: 'Plan Quinceañera Transportation',
    ctaHref: '/#getquote',
  },
  {
    id: 'bachelor-and-bachelorette-parties',
    eyebrow: 'Bachelor & Bachelorette Parties',
    title: 'One private ride for every stop',
    body:
      'Build the evening around one private ride instead of arranging separate cars between destinations. We can plan pickup from a hotel or home, coordinate multiple stops and include the return trip so the group stays together throughout the celebration.',
    image: fleetImages.partyBus.interior1,
    imageAlt: 'Lounge seating and colored lighting inside the party bus',
    benefits: [
      'Hotel or home pickup',
      'Multiple-destination itineraries',
      'Planned evening return transportation',
    ],
    ctaLabel: 'Plan Your Celebration Route',
    ctaHref: '/#getquote',
  },
  {
    id: 'holiday-lights-and-seasonal',
    eyebrow: 'Holiday Lights & Seasonal',
    title: 'Make seasonal outings easier to enjoy together',
    body:
      'Enjoy a private seasonal outing with family, friends or coworkers while one vehicle carries the group along the planned route. Christmas light trips are offered during the holiday season, with availability based on the date, pickup details and itinerary.',
    image: fleetImages.trolley.christmasLights,
    imageAlt: 'White trolley decorated with holiday lights at dusk',
    benefits: [
      'Private Christmas light outings',
      'Family, friend and company groups',
      'Seasonal dates subject to availability',
    ],
    ctaLabel: 'Explore the Christmas Trolley',
    ctaHref: '/christmas-trolley',
  },
  {
    id: 'airport-transportation',
    eyebrow: 'Airport Transportation',
    title: 'One comfortable pickup for the whole group',
    body:
      'Bring an organized group to or from the airport in one coordinated vehicle, with the hotel, pickup window and destination included in the plan. Passenger count, luggage needs and timing help determine which vehicle is the practical fit.',
    image: fleetImages.sprinter.executiveVan.front,
    imageAlt: 'Black Executive Van exterior',
    benefits: [
      'Airport pickups and drop-offs',
      'Hotel and destination coordination',
      'Passenger, luggage and timing considerations',
    ],
    ctaLabel: 'Request Airport Transportation',
    ctaHref: '/#getquote',
  },
  {
    id: 'coach-bus-charters',
    eyebrow: 'Coach Bus Charters',
    title: 'More room for guest shuttles and longer trips',
    body:
      'For guest shuttles, event transfers and longer itineraries, the Super Coach Bus gives larger groups room to travel together. It seats up to 57 passengers and can coordinate hotel, venue and event stops around one shared transportation schedule.',
    image: fleetImages.coach.exterior1,
    imageAlt: 'White Super Coach Bus exterior',
    benefits: [
      'Seating for up to 57 passengers',
      'Hotel, venue and event transfers',
      'Guest shuttles and longer itineraries',
    ],
    ctaLabel: 'Explore Coach Bus Charters',
    ctaHref: '/fleet/super-coach-bus',
  },
  {
    id: 'night-out-and-general-charters',
    eyebrow: 'Night Out & General Charters',
    title: 'Flexible private transportation built around your itinerary',
    body:
      'Plan a birthday, anniversary, group night out or general private charter around the places you actually want to visit. Share your pickup point, multiple stops and preferred return time, and we will help match the itinerary with an appropriate vehicle.',
    image: fleetImages.partyBus.exterior,
    imageAlt: 'Black party bus exterior',
    benefits: [
      'Birthdays, anniversaries and nights out',
      'Flexible routes with multiple stops',
      'Pickup and return planning',
    ],
    ctaLabel: 'Request a Private Charter Quote',
    ctaHref: '/#getquote',
  },
] as const;

const reasons = [
  {
    title: 'The right vehicle',
    body: 'Choose from the classic trolley, limo van, party bus and Super Coach Bus.',
  },
  {
    title: 'Professional service',
    body: 'Licensed and insured transportation with a professional chauffeur included.',
  },
  {
    title: 'Flexible group sizes',
    body: 'Options range from smaller private groups to coach transportation for up to 57 passengers.',
  },
  {
    title: 'Custom event planning',
    body: 'Share your pickup details, timing and planned stops so the route fits the occasion.',
  },
  {
    title: 'Chicago-area knowledge',
    body: 'Private transportation throughout Chicago and many surrounding Chicagoland suburbs.',
  },
] as const;
---
<BaseLayout
  title="Chicago Transportation Services | ChiTown Trolley"
  description="Private transportation for Chicago weddings, corporate events, celebrations, airport transfers, tours and group charters. Explore ChiTown Trolley services."
  image={servicesBannerBackground}
>
  <section
    class="services-hero"
    aria-labelledby="services-title"
    style={`background-image: url('${servicesBannerBackground.src}')`}
  >
    <div class="services-hero__overlay"></div>
    <div class="services-hero__content">
      <p class="services-hero__eyebrow">Chicago Group Transportation</p>
      <h1 id="services-title">Transportation for <em>Every Occasion</em></h1>
      <p class="services-hero__lead">
        ChiTown Trolley provides private transportation for corporate events, weddings,
        celebrations, airport transfers, tours and groups throughout Chicago and Chicagoland.
      </p>
      <div class="services-hero__actions">
        <a href={withBase('/#getquote')} class="btn-gold">Request a Quote</a>
        <a href="#featured-services" class="services-hero__secondary">Explore Services</a>
      </div>
    </div>
  </section>

  <section
    id="featured-services"
    class="featured-services"
    aria-labelledby="featured-services-title"
  >
    <div class="wrap wrap-wide">
      <SectionHeading
        eyebrow="Featured Services"
        id="featured-services-title"
        body="A closer look at the most common ways groups use the ChiTown Trolley fleet for celebrations, organized travel and private transportation."
      >
        Built around the way your day moves
      </SectionHeading>

      <div class="featured-services__list">
        {featuredServices.map((service, index) => (
          <FeaturedServiceRow
            {...service}
            reverse={index % 2 === 1}
          />
        ))}
      </div>

      <aside class="services-destination" aria-labelledby="services-destination-title">
        <div>
          <p class="services-destination__eyebrow">Destination Service</p>
          <h3 id="services-destination-title">Planning beyond Chicagoland?</h3>
        </div>
        <p>
          For resort pickups, wedding-day stops and private group itineraries in southern
          Wisconsin, explore our <a href={withBase('/lake-geneva-wisconsin-trolley-rental')}>trolley rental guide for Lake Geneva, WI</a>
          planning guide.
        </p>
      </aside>
    </div>
  </section>

  <section class="services-reasons" aria-labelledby="services-reasons-title">
    <div class="wrap wrap-wide services-reasons__inner">
      <SectionHeading
        eyebrow="Why ChiTown Trolley"
        id="services-reasons-title"
        body="Straightforward planning, professional transportation and vehicle options that can match the size and style of your group."
      >
        The details that make group travel easier
      </SectionHeading>

      <div class="services-reasons__grid">
        {reasons.map((reason, index) => (
          <article class="reason">
            <span class="reason__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{reason.title}</h3>
            <p>{reason.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services-fleet" aria-labelledby="services-fleet-title">
    <div class="wrap wrap-wide services-fleet__inner">
      <div class="services-fleet__gallery" aria-label="ChiTown Trolley fleet preview">
        <div class="services-fleet__primary">
          <Image
            src={fleetImages.trolley.classicExterior}
            alt="Classic White Trolley"
            widths={[480, 720, 960]}
            sizes="(max-width: 760px) calc(100vw - 40px), 44vw"
            format="webp"
            quality={84}
            loading="lazy"
          />
        </div>
        <div>
          <Image
            src={fleetImages.coach.exterior1}
            alt="Super Coach Bus"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) calc(50vw - 25px), 20vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
        </div>
        <div>
          <Image
            src={fleetImages.sprinter.limoVan.front}
            alt="Black Limo Van"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) calc(50vw - 25px), 20vw"
            format="webp"
            quality={82}
            loading="lazy"
          />
        </div>
      </div>

      <div class="services-fleet__copy">
        <p class="services-fleet__eyebrow">Explore the Fleet</p>
        <h2 id="services-fleet-title">Find the right ride for your group</h2>
        <p>
          Compare the Classic White Trolley, Super Coach Bus, Party Bus and Limo Vans,
          including passenger capacity, interiors and the occasions each vehicle suits best.
        </p>
        <a href={withBase('/fleet')} class="btn-gold">View the Fleet</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .services-hero {
    position: relative;
    height: 315px;
    overflow: hidden;
    background-color: #171717;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
  .services-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 10, 7, .94) 0%,
        rgba(12, 10, 7, .84) 37%,
        rgba(12, 10, 7, .5) 64%,
        rgba(12, 10, 7, .12) 100%
      ),
      linear-gradient(0deg, rgba(12, 10, 7, .16), transparent 65%);
  }
  .services-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 15px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 30px) clamp(24px, 6vw, 96px) 0;
    animation: fadeInUp 1.1s cubic-bezier(.22, .6, .2, 1) both;
  }
  .services-hero__eyebrow,
  .services-fleet__eyebrow {
    margin: 0;
    color: var(--gold-light);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .28em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .services-hero h1 {
    margin: 0;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(36px, 5.4vw, 68px);
    font-weight: 500;
    line-height: 1.04;
    text-shadow: 0 2px 24px rgba(0, 0, 0, .42);
  }
  .services-hero h1 em {
    display: inline;
    color: var(--gold-light);
    font-weight: 500;
  }
  .services-hero__lead {
    max-width: 58ch;
    margin: 0;
    color: rgba(253, 252, 250, .9);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.55;
    letter-spacing: .02em;
    text-shadow: 0 2px 16px rgba(0, 0, 0, .35);
  }
  .services-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2px;
  }
  .services-hero__actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
  }
  .services-hero__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    color: var(--paper);
    border: 1px solid rgba(253, 252, 250, .48);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .2em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 220ms ease, background 220ms ease;
  }
  .services-hero__secondary:hover {
    border-color: var(--paper);
    background: rgba(253, 252, 250, .08);
  }
  .featured-services {
    padding: 50px 28px 118px;
    background: var(--paper);
    scroll-margin-top: calc(var(--nav-h, 80px) + 18px);
  }
  .featured-services__list {
    display: grid;
    gap: 0;
    margin-top: 62px;
    border-block: 1px solid var(--line-2);
  }
  .services-destination {
    display: grid;
    grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: clamp(30px, 6vw, 80px);
    margin-top: 58px;
    padding: 34px clamp(26px, 4vw, 48px);
    border-left: 3px solid var(--gold-dark);
    background: var(--cream);
  }
  .services-destination__eyebrow {
    margin: 0 0 9px;
    color: var(--gold-deep);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
  }
  .services-destination h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 500;
    line-height: 1.1;
  }
  .services-destination > p {
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.72;
  }
  .services-destination a {
    color: var(--gold-deep);
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .services-reasons {
    padding: 104px 28px;
    background: var(--cream);
    border-block: 1px solid var(--line);
  }
  .services-reasons__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 56px;
    border-block: 1px solid var(--line-2);
  }
  .reason {
    min-width: 0;
    padding: 30px 24px 34px;
    border-left: 1px solid var(--line-2);
  }
  .reason:first-child {
    border-left: 0;
  }
  .reason__number {
    display: block;
    margin-bottom: 20px;
    color: var(--gold-deep);
    font-family: var(--serif);
    font-size: 16px;
  }
  .reason h3 {
    margin: 0 0 12px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.2;
  }
  .reason p {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 300;
    line-height: 1.65;
  }

  .services-fleet {
    padding: 112px 28px;
    background: #171717;
  }
  .services-fleet__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr);
    align-items: center;
    gap: clamp(50px, 8vw, 104px);
  }
  .services-fleet__gallery {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .services-fleet__gallery > div {
    min-width: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    background: #26231e;
  }
  .services-fleet__gallery .services-fleet__primary {
    grid-column: 1 / 3;
    aspect-ratio: 16 / 8.5;
  }
  .services-fleet__gallery :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .services-fleet__copy {
    max-width: 510px;
  }
  .services-fleet__copy h2 {
    margin: 0;
    color: var(--paper);
    font-family: var(--serif);
    font-size: clamp(34px, 4.3vw, 52px);
    font-weight: 500;
    line-height: 1.06;
  }
  .services-fleet__copy > p:not(.services-fleet__eyebrow) {
    margin: 22px 0 30px;
    color: rgba(253, 252, 250, .72);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.75;
  }

  @media (max-width: 1024px) {
    .services-reasons__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .reason:nth-child(4) {
      border-left: 0;
    }
  }

  @media (max-width: 820px) {
    .services-fleet__inner {
      grid-template-columns: 1fr;
    }
    .services-fleet__copy {
      max-width: 650px;
    }
  }

  @media (max-width: 640px) {
    .services-hero {
      height: 280px;
      background-position: center;
    }
    .services-hero__overlay {
      background: linear-gradient(
        90deg,
        rgba(10, 8, 6, .94) 0%,
        rgba(10, 8, 6, .82) 54%,
        rgba(10, 8, 6, .46) 100%
      );
    }
    .services-hero__content {
      gap: 10px;
      padding: 18px 18px 0;
    }
    .services-hero__eyebrow {
      font-size: 9px;
      letter-spacing: .25em;
    }
    .services-hero h1 {
      font-size: clamp(28px, 9vw, 40px);
      line-height: 1.05;
    }
    .services-hero__lead {
      max-width: 46ch;
      font-size: 12.5px;
      line-height: 1.45;
    }
    .services-hero__actions {
      gap: 7px;
      margin-top: 0;
    }
    .services-hero__actions :global(a) {
      width: auto;
      min-height: 44px;
      padding: 10px 12px;
      font-size: 9px;
      letter-spacing: .15em;
      white-space: nowrap;
    }
    .featured-services,
    .services-reasons,
    .services-fleet {
      padding-inline: 20px;
    }
    .featured-services {
      padding-block: 80px 88px;
    }
    .featured-services__list {
      margin-top: 46px;
    }
    .services-destination {
      grid-template-columns: 1fr;
      gap: 17px;
      margin-top: 42px;
      padding: 29px 24px;
    }
    .services-reasons {
      padding-block: 80px;
    }
    .services-reasons__grid {
      grid-template-columns: 1fr;
      margin-top: 44px;
    }
    .reason,
    .reason:nth-child(4) {
      min-height: 0;
      padding: 25px 4px 27px;
      border-left: 0;
      border-top: 1px solid var(--line-2);
    }
    .reason:first-child {
      border-top: 0;
    }
    .reason__number {
      margin-bottom: 12px;
    }
    .services-fleet {
      padding-block: 84px;
    }
    .services-fleet__inner {
      gap: 42px;
    }
    .services-fleet__gallery {
      gap: 8px;
    }
    .services-fleet__copy h2 {
      font-size: clamp(34px, 10.5vw, 44px);
    }
  }

  @media (max-width: 360px) {
    .services-hero__content,
    .featured-services,
    .services-reasons,
    .services-fleet {
      padding-inline: 16px;
    }
    .services-hero__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-hero__content,
    .services-hero__secondary {
      animation: none;
      transition: none;
    }
  }
</style>
