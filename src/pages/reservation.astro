---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, eventTypes, vehicleOptions, hoursOptions, resNotes, hasPhone } from '../data/site';
import { withBase } from '../utils/paths';

const additionalStopOptions = [
  'No additional stops',
  ...Array.from({ length: 10 }, (_, index) =>
    `${index + 1} additional ${index === 0 ? 'stop' : 'stops'}`,
  ),
];
---
<BaseLayout
  title="Reserve Your Ride — ChiTown Trolley"
  description="Request a reservation for your Chicago wedding or event. Share your contact, trip and vehicle details so ChiTown Trolley can confirm availability and pricing."
>
  <PageHero eyebrow="Reservation" pb={48}>
    Reserve <em class="grad">your ride</em>
    <p slot="lead">Share your plans below. We’ll review the route, confirm availability and follow up with your reservation details.</p>
  </PageHero>

  <section class="res wrap wrap-1140">
    <div class="res__formcol">
      <form
        class="rform"
        name="reservation-request"
        method="POST"
        data-netlify="true"
        data-netlify-form="true"
        data-netlify-honeypot="bot-field"
        data-res-form
      >
        <input type="hidden" name="form-name" value="reservation-request" />
        <p class="netlify-honeypot" aria-hidden="true">
          <label>
            Do not fill this out:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <p class="rform__required"><span aria-hidden="true">*</span> Required fields</p>

        <fieldset class="rform__section">
          <legend class="rform__legend"><span>01</span> Customer information</legend>
          <div class="rform__grid">
            <label class="field field--full">
              <span class="field__label">Full Name <span aria-hidden="true">*</span></span>
              <input required name="name" type="text" autocomplete="name" placeholder="Your full name" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Phone Number <span aria-hidden="true">*</span></span>
              <input required name="phone" type="tel" autocomplete="tel" placeholder="(312) 555-0000" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Email <span aria-hidden="true">*</span></span>
              <input required name="email" type="email" autocomplete="email" placeholder="you@example.com" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Best Time to Call</span>
              <input name="best-time-to-call" type="time" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Preferred Contact Method</span>
              <select name="preferred-contact-method" class="field__control">
                <option>Phone</option>
                <option>Email</option>
                <option>Either</option>
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset class="rform__section">
          <legend class="rform__legend"><span>02</span> Trip information</legend>
          <div class="rform__grid">
            <label class="field field--full">
              <span class="field__label">Event <span aria-hidden="true">*</span></span>
              <select required name="event" class="field__control">
                <option value="" disabled selected>Select event type</option>
                {eventTypes.map((eventType) => <option value={eventType}>{eventType}</option>)}
              </select>
            </label>
            <label class="field">
              <span class="field__label">Pickup Date <span aria-hidden="true">*</span></span>
              <input required name="pickup-date" type="date" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Pickup Time <span aria-hidden="true">*</span></span>
              <input required name="pickup-time" type="time" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Return Time</span>
              <input name="return-time" type="time" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Additional Stops</span>
              <select name="additional-stops" class="field__control">
                {additionalStopOptions.map((option) => <option value={option}>{option}</option>)}
              </select>
            </label>
            <label class="field field--full">
              <span class="field__label">Pickup Location <span aria-hidden="true">*</span></span>
              <input required name="pickup-location" type="text" placeholder="Street address, city and ZIP" class="field__control" />
            </label>
            <label class="field field--full">
              <span class="field__label">Drop-off Location <span aria-hidden="true">*</span></span>
              <input required name="dropoff-location" type="text" placeholder="Street address, city and ZIP" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Traveling into Chicago? <span aria-hidden="true">*</span></span>
              <select required name="traveling-to-chicago" class="field__control">
                <option value="" disabled selected>Select one</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
              </select>
            </label>
            <label class="field">
              <span class="field__label">Alcohol on the Vehicle? <span aria-hidden="true">*</span></span>
              <select required name="alcohol" class="field__control">
                <option value="" disabled selected>Select one</option>
                <option value="No">No</option>
                <option value="Yes — guests are 21+">Yes — guests are 21+</option>
              </select>
            </label>
            <label class="field field--full">
              <span class="field__label">Message</span>
              <textarea name="message" rows="4" placeholder="List stop addresses, timing details, accessibility needs or anything else we should know" class="field__control"></textarea>
            </label>
          </div>
        </fieldset>

        <fieldset class="rform__section">
          <legend class="rform__legend"><span>03</span> Vehicle &amp; service</legend>
          <div class="rform__grid">
            <label class="field">
              <span class="field__label">Number of Hours <span aria-hidden="true">*</span></span>
              <select required name="hours" class="field__control">
                <option value="" disabled selected>Select service length</option>
                {hoursOptions.map((hours) => <option value={hours}>{hours}</option>)}
              </select>
            </label>
            <label class="field">
              <span class="field__label">Requested Vehicle <span aria-hidden="true">*</span></span>
              <select required name="vehicle" class="field__control">
                <option value="" disabled selected>Select a vehicle</option>
                {vehicleOptions.map((vehicle) => <option value={vehicle}>{vehicle}</option>)}
              </select>
            </label>
            <label class="field">
              <span class="field__label">Number of Passengers <span aria-hidden="true">*</span></span>
              <input required name="passengers" type="number" min="1" max="57" inputmode="numeric" placeholder="Up to 57" class="field__control" />
            </label>
          </div>
        </fieldset>

        <fieldset class="rform__section">
          <legend class="rform__legend"><span>04</span> Quote &amp; billing contact</legend>
          <div class="rform__grid">
            <label class="field">
              <span class="field__label">Price Quote</span>
              <input name="price-quote" type="text" inputmode="decimal" placeholder="Quoted amount or email reference" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Promo Code</span>
              <input name="promo-code" type="text" autocomplete="off" placeholder="If applicable" class="field__control" />
            </label>
            <label class="field field--full">
              <span class="field__label">Billing Contact Name</span>
              <input name="billing-name" type="text" autocomplete="billing name" placeholder="Name associated with the future payment" class="field__control" />
            </label>
            <label class="field field--full">
              <span class="field__label">Billing Street Address</span>
              <input name="billing-street-address" type="text" autocomplete="billing street-address" placeholder="Street address" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">City</span>
              <input name="billing-city" type="text" autocomplete="billing address-level2" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">State</span>
              <input name="billing-state" type="text" autocomplete="billing address-level1" maxlength="2" placeholder="IL" class="field__control" />
            </label>
            <label class="field">
              <span class="field__label">Billing ZIP Code</span>
              <input name="billing-zip" type="text" autocomplete="billing postal-code" inputmode="numeric" placeholder="60007" class="field__control" />
            </label>
          </div>
        </fieldset>

        <label class="rform__agreement">
          <input required name="agreement" type="checkbox" value="Accepted" />
          <span>
            I agree to the ChiTown Trolley <a href={withBase(site.routes.terms)}>Terms and Conditions</a> and <a href={withBase(site.routes.privacy)}>Privacy Policy</a>.
          </span>
        </label>

        <div class="rform__submit">
          <button type="submit" class="btn-gold">Submit Reservation Request</button>
        </div>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>

    <aside class="aside">
      <div>
        <p class="aside__eyebrow">Prefer to book by phone?</p>
        {hasPhone ? (
          <a href={site.contact.phoneHref} class="aside__phone">{site.contact.phoneDisplay}</a>
        ) : (
          <span class="aside__phone">{site.contact.phoneDisplay}</span>
        )}
        <a href={`mailto:${site.contact.email}`} class="aside__email">{site.contact.email}</a>
      </div>
      <div class="rule-gold"></div>
      <div class="aside__notes">
        {resNotes.map((note) => (
          <div class="resnote">
            <span class="resnote__diamond">◆</span>
            <p class="resnote__text">{note}</p>
          </div>
        ))}
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .res {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: start;
    gap: clamp(52px, 7vw, 88px);
    padding: 0 28px 100px;
  }
  .res__formcol { min-width: 0; }
  .rform { display: flex; flex-direction: column; }
  .rform__required {
    align-self: flex-end;
    margin: 0 0 8px;
    color: var(--faint);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .rform__required span,
  .field__label span { color: var(--gold-deep); }
  .rform__section {
    min-width: 0;
    margin: 0;
    padding: 30px 0 38px;
    border: 0;
    border-top: 1px solid var(--line-2);
  }
  .rform__legend {
    padding: 0 18px 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(24px, 2.5vw, 30px);
    font-weight: 600;
    line-height: 1.1;
  }
  .rform__legend span {
    margin-right: 10px;
    color: var(--gold-deep);
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .16em;
    vertical-align: middle;
  }
  .rform__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 28px;
    margin-top: 26px;
  }
  .rform__agreement {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    margin: 2px 0 26px;
    color: var(--muted);
    cursor: pointer;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
  }
  .rform__agreement input {
    flex: none;
    width: 19px;
    height: 19px;
    margin: 2px 0 0;
    accent-color: var(--gold-dark);
  }
  .rform__agreement a { color: var(--gold-deep); text-underline-offset: 3px; }
  .rform__submit { margin-top: 2px; }

  .aside {
    position: sticky;
    top: 118px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .aside__eyebrow {
    margin: 0 0 12px;
    color: var(--gold-deep);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .28em;
    text-transform: uppercase;
  }
  .aside__phone {
    display: block;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 600;
    text-decoration: none;
    transition: color .25s ease;
  }
  .aside__phone:hover { color: var(--gold-deep); }
  .aside__email {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 300;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: color .25s ease;
  }
  .aside__email:hover { color: var(--gold-deep); }
  .aside__notes { display: flex; flex-direction: column; gap: 18px; }
  .resnote { display: flex; align-items: baseline; gap: 13px; }
  .resnote__diamond { flex: none; color: var(--gold-dark); font-size: 9px; }
  .resnote__text {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .res { grid-template-columns: 1fr; gap: 56px; }
    .aside {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1px 1fr;
      align-items: start;
    }
    .aside > .rule-gold { width: 1px; height: 100%; background: var(--line-2); }
  }
  @media (max-width: 640px) {
    .res { gap: 44px; padding: 0 18px 80px; }
    .rform__section { padding-block: 26px 32px; }
    .rform__grid { grid-template-columns: 1fr; gap: 22px; margin-top: 24px; }
    .field--full { grid-column: auto; }
    .rform__submit .btn-gold { width: 100%; text-align: center; }
    .aside { display: flex; gap: 28px; }
    .aside > .rule-gold { width: auto; height: 1px; }
  }
</style>
