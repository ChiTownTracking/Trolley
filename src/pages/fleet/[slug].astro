---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getImage, Image } from 'astro:assets';
import { fleet } from '../../data/fleet';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return fleet.map((vehicle) => ({
    params: { slug: vehicle.slug },
    props: { vehicle },
  }));
}

const { vehicle } = Astro.props;
const images = vehicle.gallery;
const hasGallery = images.length > 1;
const metaDescription = vehicle.intro.length <= 155
  ? vehicle.intro
  : `${vehicle.intro.slice(0, 152).replace(/\s+\S*$/, '').trimEnd()}...`;
const imageWidths = (width: number) => {
  const widths = [480, 768, 1000, 1400].filter((candidate) => candidate < width);
  return [...widths, width];
};
const fullscreenImages = await Promise.all(
  images.map((image) => getImage({
    src: image,
    width: Math.min(image.width, 1600),
    format: 'webp',
    quality: 82,
  })),
);
---
<BaseLayout
  title={`${vehicle.name} — ChiTown Trolley`}
  description={metaDescription}
  hideCta={true}
  preloadSerifItalic={false}
>
  <article class="vd wrap wrap-1000">
    <a href={withBase('/fleet')} class="vd__back">← Back to Fleet</a>

    <header class="vd__head">
      {vehicle.comingSoon && <p class="vd__availability">Coming Soon</p>}
      <h1 class="vd__title">{vehicle.name}</h1>
    
    </header>

    <!-- Image gallery / carousel -->
    <div class="gal" data-gallery tabindex="0" aria-label={`${vehicle.name} photo gallery`}>
      <div class="gal__main">
        {images.map((image, i) => (
          <Image
            src={image}
            widths={imageWidths(image.width)}
            sizes="(max-width: 1056px) calc(100vw - 56px), 1000px"
            format="webp"
            quality={76}
            alt={`${vehicle.name} — photo ${i + 1}`}
            class:list={['gal__img', { 'is-active': i === 0 }]}
            data-gal-slide
            data-full-src={fullscreenImages[i].src}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
        <button type="button" class="gal__expand" data-gal-expand aria-label="View current image fullscreen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
          </svg>
        </button>
        {hasGallery && (
          <>
            <button type="button" class="gal__arrow gal__arrow--prev" data-gal-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="gal__arrow gal__arrow--next" data-gal-next aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </>
        )}
      </div>
      {hasGallery && (
        <div class="gal__thumbs" data-gal-thumbs>
          {images.map((image, i) => (
            <button type="button" class:list={['gal__thumb', { 'is-active': i === 0 }]} data-gal-thumb={i} aria-label={`Show image ${i + 1}`}>
              <Image src={image} width={192} format="webp" quality={65} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
      <dialog class="gal-lightbox" data-gal-lightbox aria-label={`${vehicle.name} fullscreen photo viewer`}>
        <button type="button" class="gal-lightbox__close" data-lightbox-close aria-label="Close fullscreen image">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
        <div class="gal-lightbox__stage">
          <Image
            class="gal-lightbox__image"
            data-lightbox-image
            src={images[0]}
            width={Math.min(images[0].width, 1600)}
            format="webp"
            quality={82}
            alt={`${vehicle.name} — photo 1`}
          />
          {hasGallery && (
            <>
              <button type="button" class="gal-lightbox__arrow gal-lightbox__arrow--prev" data-lightbox-prev aria-label="Previous fullscreen image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <button type="button" class="gal-lightbox__arrow gal-lightbox__arrow--next" data-lightbox-next aria-label="Next fullscreen image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </>
          )}
        </div>
        <p class="gal-lightbox__count" data-lightbox-count aria-live="polite">1 of {images.length}</p>
      </dialog>
    </div>
  <div class="vd__stats">
        {vehicle.stats.map((s) => (
          <div class="stat">
            <span class="stat__label">{s.label}</span>
            <span class="stat__value">{s.value}</span>
          </div>
        ))}
      </div>
    <!-- Narrative intro -->
    <p class="vd__intro">{vehicle.intro}</p>

    <!-- Features + Perfect For -->
    <div class="vd__cols">
      <section class="vd__block">
        <h2 class="vd__h">Features &amp; Amenities</h2>
        <ul class="vd__feats">
          {vehicle.feats.map((f) => (
            <li class="vd__feat"><span class="vd__diamond">◆</span>{f}</li>
          ))}
        </ul>
      </section>
      <section class="vd__block">
        <h2 class="vd__h">Perfect For</h2>
        <div class="vd__tags">
          {vehicle.perfectFor.map((p) => <span class="vd__tag">{p}</span>)}
        </div>
      </section>
    </div>

    <!-- Closing CTA -->
    <section class="vd__cta">
      <h2 class="vd__cta-title">
        {vehicle.comingSoon ? 'Interested in the ' : 'Ready to reserve the '}
        <em class="grad">{vehicle.name}</em>?
      </h2>
      <p class="vd__cta-body">
        {vehicle.comingSoon
          ? 'This vehicle is coming soon. Share your date and trip details to ask about future availability.'
          : "Tell us your date and we'll confirm availability within one business day — no payment required to request."}
      </p>
      <div class="vd__cta-actions">
        <a href={withBase(`/#vehicle=${encodeURIComponent(vehicle.quoteValue)}`)} class="btn-gold">Get a Free Quote</a>
        <a href={withBase('/reservation')} class="btn-ghost">Reserve This Vehicle</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .vd { padding-block: 40px 96px; }
  .vd__back {
    display: inline-block; font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold-deep); text-decoration: none; margin-bottom: 26px; transition: color .2s ease;
  }
  .vd__back:hover { color: var(--gold-dark); }
  .vd__head { margin-bottom: 34px; }
  .vd__availability {
    display: inline-block;
    margin: 0 0 12px;
    padding: 8px 13px;
    border-radius: 999px;
    background: #133626;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .18em;
    line-height: 1;
    text-transform: uppercase;
  }
  .vd__title { font-family: var(--serif); font-size: clamp(34px, 5vw, 52px); font-weight: 600; line-height: 1.08; margin: 0; }
  .vd__stats { display: flex; flex-wrap: wrap; gap: 20px 40px; margin-top: 22px; }
  .stat { display: flex; flex-direction: column; gap: 5px; }
  .stat__label { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--gold-deep); }
  .stat__value { font-family: var(--serif); font-size: 25px; font-weight: 600; line-height: 1; }

  /* Gallery */
  .gal { outline: none; }
  .gal__main {
    position: relative; height: clamp(300px, 46vw, 540px);
    border-radius: 10px; overflow: hidden; background: var(--cream);
  }
  .gal__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; pointer-events: none; transition: opacity .5s ease;
  }
  .gal__img.is-active { opacity: 1; pointer-events: auto; cursor: zoom-in; }
  .gal__expand {
    position: absolute; top: 14px; right: 14px; z-index: 3;
    width: 44px; height: 44px; border: 0; border-radius: 50%; cursor: pointer;
    display: grid; place-items: center; color: var(--ink); background: rgba(253, 252, 250, .88);
    box-shadow: 0 2px 12px rgba(0, 0, 0, .15); transition: background .2s ease, color .2s ease;
  }
  .gal__expand:hover { background: #fff; color: var(--gold-deep); }
  .gal__expand svg { width: 20px; height: 20px; }
  .gal__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(253, 252, 250, .85); color: var(--ink);
    display: grid; place-items: center; box-shadow: 0 2px 12px rgba(0, 0, 0, .15);
    transition: background .2s ease, color .2s ease;
  }
  .gal__arrow:hover { background: #fff; color: var(--gold-deep); }
  .gal__arrow svg { width: 20px; height: 20px; }
  .gal__arrow--prev { left: 14px; }
  .gal__arrow--next { right: 14px; }
  .gal__thumbs { display: flex; gap: 12px; margin-top: 14px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .gal__thumb {
    flex: 0 0 auto; width: 96px; height: 66px; padding: 0; cursor: pointer;
    border: 2px solid transparent; border-radius: 6px; overflow: hidden; background: none;
    opacity: .6; transition: opacity .25s ease, border-color .25s ease;
  }
  .gal__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gal__thumb:hover { opacity: 1; }
  .gal__thumb.is-active { border-color: var(--gold); opacity: 1; }

  /* Fullscreen image viewer */
  :global(html.gal-lightbox-open) { overflow: hidden; }
  .gal-lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgba(12, 12, 12, .97); color: #fff; overflow: hidden;
  }
  .gal-lightbox[open] { display: grid; grid-template-rows: 1fr auto; }
  .gal-lightbox::backdrop { background: rgba(0, 0, 0, .82); }
  .gal-lightbox__stage {
    position: relative; min-width: 0; min-height: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center; padding: 64px 76px 24px;
  }
  .gal-lightbox__image {
    display: block; flex: 0 1 auto; width: auto; height: auto;
    max-width: max(1px, calc(100vw - 152px)); max-height: max(1px, calc(100dvh - 140px));
    object-fit: contain; object-position: center;
  }
  .gal-lightbox__close,
  .gal-lightbox__arrow {
    position: absolute; z-index: 2; width: 48px; height: 48px; padding: 0; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .35); background: rgba(20, 20, 20, .7); color: #fff;
    display: grid; place-items: center; cursor: pointer; transition: background .2s ease, border-color .2s ease;
  }
  .gal-lightbox__close:hover,
  .gal-lightbox__arrow:hover { background: rgba(255, 255, 255, .16); border-color: rgba(255, 255, 255, .7); }
  .gal-lightbox__close { top: 16px; right: 18px; }
  .gal-lightbox__close svg { width: 24px; height: 24px; }
  .gal-lightbox__arrow { top: 50%; transform: translateY(-50%); }
  .gal-lightbox__arrow svg { width: 25px; height: 25px; }
  .gal-lightbox__arrow--prev { left: 18px; }
  .gal-lightbox__arrow--next { right: 18px; }
  .gal-lightbox__count { margin: 0; padding: 8px 20px 22px; text-align: center; font-size: 12px; letter-spacing: .14em; color: rgba(255, 255, 255, .78); }

  /* Intro + content */
  .vd__intro {
    font-family: var(--serif); font-size: 22px; line-height: 1.6; color: var(--ink);
    margin: 46px 0 0; max-width: 66ch;
  }
  .vd__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 56px; }
  .vd__h { font-family: var(--serif); font-size: 22px; font-weight: 600; margin: 0 0 22px; }
  .vd__feats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .vd__feat { font-weight: 300; font-size: 15px; color: var(--muted); display: flex; align-items: baseline; gap: 12px; }
  .vd__diamond { color: var(--gold-dark); font-size: 11px; flex: none; }
  .vd__tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .vd__tag {
    font-size: 12px; letter-spacing: .04em; color: var(--gold-deep);
    border: 1px solid var(--gold); border-radius: 999px; padding: 8px 16px; background: var(--paper);
  }

  /* Closing CTA */
  .vd__cta {
    margin-top: 76px; text-align: center; background: var(--cream);
    border: 1px solid var(--line-2); border-radius: 10px; padding: 56px 32px;
  }
  .vd__cta-title { font-family: var(--serif); font-size: clamp(26px, 4vw, 32px); font-weight: 600; margin: 0 0 12px; }
  .vd__cta-body { font-weight: 300; font-size: 15px; color: var(--muted); line-height: 1.7; margin: 0 auto 28px; max-width: 46ch; }
  .vd__cta-actions { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; }

  @media (max-width: 700px) {
    .vd__cols { grid-template-columns: 1fr; gap: 40px; }
    .vd__intro { font-size: 20px; }
    .gal-lightbox__stage { padding: 70px 12px 80px; }
    .gal-lightbox__image { max-width: max(1px, calc(100vw - 24px)); max-height: max(1px, calc(100dvh - 150px)); }
    .gal-lightbox__arrow { top: auto; bottom: 18px; transform: none; }
    .gal-lightbox__arrow--prev { left: 18px; }
    .gal-lightbox__arrow--next { right: 18px; }
    .gal-lightbox__count { position: absolute; bottom: 32px; left: 50%; z-index: 1; transform: translateX(-50%); padding: 0; }
    /* Kept at 44px (not shrunk) — that's the tap-target minimum, and there's
       enough room in the responsive-height gallery to keep it. */
  }
  @media (prefers-reduced-motion: reduce) {
    .gal__img { transition: none; }
  }
</style>

<script>
  // Detail-page image gallery: thumbnails, arrows, and a fullscreen viewer.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gal) => {
    const slides = Array.from(gal.querySelectorAll<HTMLImageElement>('[data-gal-slide]'));
    const thumbs = Array.from(gal.querySelectorAll<HTMLElement>('[data-gal-thumb]'));
    const lightbox = gal.querySelector<HTMLDialogElement>('[data-gal-lightbox]');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxCount = lightbox?.querySelector<HTMLElement>('[data-lightbox-count]');
    let idx = 0;

    const updateLightbox = () => {
      if (!lightboxImage) return;
      const active = slides[idx];
      lightboxImage.src = active.dataset.fullSrc || active.currentSrc || active.src;
      lightboxImage.alt = active.alt;
      if (lightboxCount) lightboxCount.textContent = `${idx + 1} of ${slides.length}`;
    };

    const show = (i: number) => {
      idx = (i + slides.length) % slides.length;
      slides.forEach((s, si) => s.classList.toggle('is-active', si === idx));
      thumbs.forEach((t, ti) => t.classList.toggle('is-active', ti === idx));
      if (!lightbox?.open) thumbs[idx]?.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: 'smooth' });
      updateLightbox();
    };

    const openLightbox = (i = idx) => {
      if (!lightbox) return;
      show(i);
      lightbox.showModal();
      document.documentElement.classList.add('gal-lightbox-open');
    };

    const closeLightbox = () => lightbox?.close();

    thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    gal.querySelector('[data-gal-prev]')?.addEventListener('click', () => show(idx - 1));
    gal.querySelector('[data-gal-next]')?.addEventListener('click', () => show(idx + 1));
    gal.querySelector('[data-gal-expand]')?.addEventListener('click', () => openLightbox());
    slides.forEach((slide, i) => slide.addEventListener('click', () => openLightbox(i)));
    lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
    lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(idx - 1));
    lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(idx + 1));
    lightbox?.addEventListener('close', () => document.documentElement.classList.remove('gal-lightbox-open'));
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    gal.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && slides.length > 1) { e.preventDefault(); show(idx - 1); }
      else if (e.key === 'ArrowRight' && slides.length > 1) { e.preventDefault(); show(idx + 1); }
    });
  });
</script>
