---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { fleet } from '../data/fleet';
import { eventTypes, hoursOptions, vehicleOptions } from '../data/site';
import { withBase } from '../utils/paths';
import lakeGenevaHero from '../assets/images/lake-geneva-trolley-hero.webp';
import lakeGenevaTrolleyExteriorInterior from '../assets/images/lake-geneva/lake-geneva-trolley-exterior-interior.png';
import lakeGenevaResortsImage from '../assets/images/lake-geneva/lake-geneva-autumn-resorts.jpg';
import lakeGenevaDockAtDusk from '../assets/images/lake-geneva/lake-geneva-dock-at-dusk.jpg';
import lakeGenevaMansionAutumn from '../assets/images/lake-geneva/lake-geneva-mansion-autumn.jpg';

const classicTrolley = fleet.find((vehicle) => vehicle.slug === 'classic-white-trolley');

if (!classicTrolley) {
  throw new Error('The Lake Geneva, WI page requires the Classic White Trolley fleet data.');
}

const quoteHref = '#lake-geneva-quote';
const classicTrolleyHref = withBase(`/fleet/${classicTrolley.slug}`);
const passengerOptions = ['1–10', '11–20', '21–30', '31–40', '41–57'];

const trustItems = [
  'Private Group Transportation',
  'Classic White Trolley',
  'Wedding & Event Service',
  'Professional Chauffeur Included',
  'Lake Geneva, WI Service by Reservation',
] as const;

const itinerarySteps = [
  {
    number: '01',
    title: 'Resort or Hotel Pickup',
    body: 'Begin with one confirmed meeting point for the wedding party or private group. Pickup can be planned around a hotel, resort or vacation accommodation, with enough time for everyone to gather, board and depart together before the next scheduled stop.',
  },
  {
    number: '02',
    title: 'Ceremony Transportation',
    body: 'The departure time is built backward from the ceremony schedule, expected loading time and route. Keeping the group aboard one vehicle helps avoid separate arrivals while giving the planner, couple or group contact one coordinated transportation timeline.',
  },
  {
    number: '03',
    title: 'Photo Stops in Lake Geneva, WI',
    body: 'Approved photo locations can be added between the ceremony and reception when travel time, parking access and the reservation length allow. Share preferred stops early so the schedule can account for unloading, photographs and boarding without rushing the next destination.',
  },
  {
    number: '04',
    title: 'Reception & Return Service',
    body: 'The itinerary can finish with a scheduled reception arrival and, when included in the confirmed reservation, planned return transportation. Final timing should identify the pickup point, destination and passengers expected so the closing portion of the route remains clear.',
  },
] as const;

const popularResorts = [
  {
    name: 'Grand Geneva Resort & Spa',
    location: 'Lake Geneva, WI',
    description:
      'An expansive resort campus with lodge and villa accommodations, two championship golf courses, WELL Spa, seasonal skiing and the Timber Ridge indoor waterpark.',
    planningNote:
      'Confirm the exact building and entrance before setting the trolley pickup time.',
    href: 'https://www.grandgeneva.com/',
  },
  {
    name: 'The Abbey Resort',
    location: 'Fontana-on-Geneva Lake',
    description:
      'A 90-acre waterfront resort with lake-inspired guestrooms, on-site dining, indoor and outdoor pools, marina activities and Avani Spa.',
    planningNote:
      'Identify the group’s lodging building and the resort-approved loading point.',
    href: 'https://www.theabbeyresort.com/',
  },
  {
    name: 'Destination Geneva National',
    location: 'Lake Geneva, WI',
    description:
      'Lodging includes the Lodge, suites and multi-bedroom cottages, with access to six dining options, saltwater pools, a marina, outdoor activities and 54 holes of golf.',
    planningNote:
      'Specify whether pickup is at the Lodge, Clubhouse, suites or cottages.',
    href: 'https://www.destinationgn.com/',
  },
] as const;

const lakeGenevaFaqs = [
  {
    q: 'Do you offer trolley rentals in Lake Geneva, Wisconsin?',
    a: 'Yes. ChiTown Trolley provides private trolley service for qualifying events in Lake Geneva, WI, by reservation. Service depends on the event date, complete itinerary, trip duration and vehicle availability. Share every pickup and stop when requesting a quote so the route can be reviewed accurately.',
  },
  {
    q: 'How much does a trolley rental in Lake Geneva, WI cost?',
    a: 'Pricing is customized rather than posted as a single flat rate. The estimate depends on the date, requested vehicle, rental duration, pickup location, planned itinerary and total service time. Submit those details through the quote form for a trip-specific estimate.',
  },
  {
    q: 'Can we use the trolley for a wedding in Lake Geneva, WI?',
    a: 'Yes, subject to availability and route confirmation. A wedding itinerary may include hotel or resort pickup, ceremony transportation, approved photo stops, reception arrival and a scheduled return when it is included in the reservation.',
  },
  {
    q: 'Can the trolley make multiple stops around Lake Geneva, WI?',
    a: 'Multiple stops can be planned when the addresses, timing, loading access and overall reservation length are approved in advance. Include each requested destination with your inquiry; a stop should not be assumed until it appears in the confirmed itinerary.',
  },
  {
    q: 'Do you provide transportation for wedding guests as well as the wedding party?',
    a: 'Yes. The Classic White Trolley can carry the wedding party while a larger coach handles guest transportation between hotels, the ceremony and reception. The appropriate combination depends on passenger counts, luggage needs, timing and vehicle availability.',
  },
  {
    q: 'How far in advance should we reserve a wedding trolley in Lake Geneva, WI?',
    a: 'Popular wedding-season Saturdays often fill six to twelve months ahead, so early planning gives you the best date and time selection. It is still worth asking about closer dates because availability varies throughout the year.',
  },
  {
    q: 'Do you serve Fontana and Williams Bay?',
    a: 'Service beyond central Lake Geneva, WI, depends on the complete route. Share every address when requesting a quote so the team can confirm availability in Lake Geneva, WI; Fontana; Williams Bay; and other surrounding communities included in your itinerary.',
  },
] as const;
---

<BaseLayout
  title="Lake Geneva, WI Trolley Rental | Weddings & Events | ChiTown Trolley"
  description="Book a trolley rental in Lake Geneva, WI, for weddings, private events and group transportation. Classic white trolley service with custom itineraries."
  image={lakeGenevaHero}
  hideCta={true}
>
  <section class="lg-hero" aria-labelledby="lake-geneva-title">
    <Image
      src={lakeGenevaHero}
      alt="White trolley beside a lakefront promenade"
      widths={[640, 960, 1280, 1600, 1870]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="lg-hero__image"
    />
    <div class="lg-hero__overlay"></div>
    <div class="lg-hero__content wrap wrap-1140">
      <p class="lg-hero__eyebrow">Lake Geneva, Wisconsin</p>
      <h1 id="lake-geneva-title">Lake Geneva, WI Trolley Rental</h1>
      <p class="lg-hero__lead">
        Private trolley transportation for weddings, celebrations and coordinated group travel throughout Lake Geneva, WI, and the surrounding area.
      </p>
      <div class="lg-hero__actions">
        <a href={quoteHref} class="btn-gold">Request a Trolley Quote for Lake Geneva, WI</a>
        <a href={classicTrolleyHref} class="lg-button-outline">View the White Trolley</a>
      </div>
    </div>
  </section>

  <section class="lg-trust" aria-label="Lake Geneva, WI trolley service facts">
    <div class="lg-trust__inner wrap wrap-wide">
      {trustItems.map((item) => (
        <span><i aria-hidden="true"></i>{item}</span>
      ))}
    </div>
  </section>

  <section class="rv getquote" id="lake-geneva-quote" aria-labelledby="lake-geneva-quote-title">
    <div class="getquote__inner">
      <h2 class="h-section getquote__title" id="lake-geneva-quote-title">
        Request a <em class="grad">trolley rental quote for Lake Geneva, WI</em>
      </h2>

      <form
        class="qform wizard"
        name="quote-request"
        method="POST"
        data-netlify="true"
        data-netlify-form="true"
        data-netlify-honeypot="bot-field"
        data-quote-form
      >
        <input type="hidden" name="form-name" value="quote-request" />
        <input type="hidden" name="notification-form" value="lake-geneva-quote-request" />
        <p class="netlify-honeypot" aria-hidden="true">
          <label>
            Do not fill this out:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="step is-open" data-step="1">
          <button type="button" class="step__head" data-step-toggle="1" aria-expanded="true">
            <span class="step__num"><span class="step__digit">1</span></span>
            <span class="step__label">
              <span class="step__kicker">Step 1 of 3</span>
              <span class="step__name">Trip Information</span>
            </span>
            <span class="step__chev" aria-hidden="true"></span>
          </button>
          <div class="step__panel">
            <div class="step__body">
              <div class="step__inner">
                <div class="step__grid">
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="event-type">Event Type</label>
                    <select id="event-type" name="type" class="field__control">
                      <option value="" disabled selected>Select event type</option>
                      {eventTypes.map((eventType) => <option>{eventType}</option>)}
                    </select>
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="number-of-hours">Number of Hours</label>
                    <select id="number-of-hours" name="hours" class="field__control">
                      <option value="" disabled selected>Select duration</option>
                      {hoursOptions.map((duration) => <option>{duration}</option>)}
                    </select>
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="vehicle">Vehicle</label>
                    <select id="vehicle" name="vehicle" class="field__control">
                      <option value="" disabled>Select vehicle</option>
                      {vehicleOptions.map((vehicle) => (
                        <option selected={vehicle === classicTrolley.quoteValue}>{vehicle}</option>
                      ))}
                    </select>
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="number-of-passengers">Number of Passengers</label>
                    <select id="number-of-passengers" name="passengers" class="field__control">
                      <option value="" disabled selected>Select group size</option>
                      {passengerOptions.map((passengers) => <option>{passengers}</option>)}
                    </select>
                  </div>
                </div>
                <div class="step__nav">
                  <button type="button" class="btn-gold" data-step-next="2">Next</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="step" data-step="2">
          <button type="button" class="step__head" data-step-toggle="2" aria-expanded="false">
            <span class="step__num"><span class="step__digit">2</span></span>
            <span class="step__label">
              <span class="step__kicker">Step 2 of 3</span>
              <span class="step__name">Itinerary</span>
            </span>
            <span class="step__chev" aria-hidden="true"></span>
          </button>
          <div class="step__panel">
            <div class="step__body">
              <div class="step__inner">
                <div class="step__grid">
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="event-date">Event Date</label>
                    <input id="event-date" name="date" type="date" class="field__control" />
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="pickup-time">Pickup Time</label>
                    <input id="pickup-time" name="time" type="time" class="field__control" />
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="pickup-location">Pickup Location</label>
                    <input
                      id="pickup-location"
                      name="pickup"
                      type="text"
                      value="Lake Geneva, WI"
                      placeholder="Enter pickup address"
                      class="field__control"
                    />
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="destination">Destination</label>
                    <input id="destination" name="dropoff" type="text" placeholder="Enter destination" class="field__control" />
                  </div>
                </div>
                <div class="step__nav">
                  <button type="button" class="btn-ghost" data-step-back="1">Back</button>
                  <button type="button" class="btn-gold" data-step-next="3">Next</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="step" data-step="3">
          <button type="button" class="step__head" data-step-toggle="3" aria-expanded="false">
            <span class="step__num"><span class="step__digit">3</span></span>
            <span class="step__label">
              <span class="step__kicker">Step 3 of 3</span>
              <span class="step__name">Personal Info</span>
            </span>
            <span class="step__chev" aria-hidden="true"></span>
          </button>
          <div class="step__panel">
            <div class="step__body">
              <div class="step__inner">
                <div class="step__grid step__grid--3">
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="full-name">Full Name</label>
                    <input required id="full-name" name="name" type="text" placeholder="Enter your full name" class="field__control" />
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="phone-number">Phone Number</label>
                    <input required id="phone-number" name="phone" type="tel" placeholder="Enter your phone number" class="field__control" />
                  </div>
                  <div class="qfield qfield--labeled">
                    <label class="qfield__label" for="email-address">Email Address</label>
                    <input required id="email-address" name="email" type="email" placeholder="Enter your email address" class="field__control" />
                  </div>
                  <div class="qfield qfield--labeled qfield--wide">
                    <label class="qfield__label" for="referral-source">How Did You Find Us?</label>
                    <textarea id="referral-source" name="message" rows="2" placeholder="Tell us how you found us" class="field__control"></textarea>
                  </div>
                </div>
                <div class="step__nav">
                  <button type="button" class="btn-ghost" data-step-back="2">Back</button>
                  <button type="submit" class="btn-gold">Submit</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        <p class="getquote__disclaimer">
          Trolley rental prices in Lake Geneva, WI vary by date, vehicle, rental duration, itinerary and pickup details.
          Share your plans for a customized estimate.
        </p>
      </form>
    </div>
  </section>

  <section class="lg-intro" aria-labelledby="lake-geneva-intro-title">
    <div class="lg-intro__inner wrap wrap-1140">
      <div class="lg-intro__media rv">
        <Image
          src={lakeGenevaTrolleyExteriorInterior}
          alt="White trolley beside the lake and its wood-trimmed passenger cabin"
          widths={[400, 555, 800, 1100]}
          sizes="(max-width: 840px) calc(100vw - 40px), 48vw"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
          class="lg-intro__image"
        />
      </div>
      <div class="lg-intro__copy rv">
        <Eyebrow label="Private Trolley Transportation" align="left" single size="sm" mb={17} />
        <h2 id="lake-geneva-intro-title">A trolley experience made for celebrations in Lake Geneva, WI</h2>
        <p>
          Lake Geneva, Wisconsin, is a destination where one event can span a full wedding weekend. Guests may stay at a downtown hotel, lakeside resort or vacation property while the ceremony, photographs and reception take place at separate destinations around Geneva Lake. A private trolley gives the wedding party or event group one vehicle, one meeting point and one coordinated schedule instead of relying on separate cars between stops.
        </p>
        <p>
          ChiTown Trolley serves itineraries in Lake Geneva, WI, by reservation. Service is planned around confirmed pickup locations, passenger count, scheduled stops and event timing, including hotel pickup and return transportation when those details are part of the reservation. Availability depends on the date, requested vehicle, trip duration and complete route, so the most useful inquiry includes every address and the timing that matters to your day.
        </p>
        <a href={quoteHref} class="link-gold">Share Your Itinerary for Lake Geneva, WI →</a>
      </div>
    </div>
  </section>

  <section class="lg-itinerary" aria-labelledby="lake-geneva-itinerary-title">
    <div class="wrap wrap-wide">
      <header class="lg-section-head">
        <Eyebrow label="Lake Geneva, WI Weddings & Events" mb={17} />
        <h2 id="lake-geneva-itinerary-title">One itinerary from hotel pickup to the final stop</h2>
        <p>
          Destination events work best when loading time, travel time and venue access are considered together—not as separate rides arranged at the last minute.
        </p>
      </header>

      <ol class="lg-itinerary__steps">
        {itinerarySteps.map((step) => (
          <li class="lg-itinerary__step rv">
            <span class="lg-itinerary__number" aria-hidden="true">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>

      <aside class="lg-destination rv" aria-labelledby="lake-geneva-planning-title">
        <div class="lg-destination__heading">
          <p class="lg-destination__kicker">Destination Planning</p>
          <h3 id="lake-geneva-planning-title">Planning transportation around Lake Geneva, WI</h3>
        </div>
        <div class="lg-destination__copy">
          <p>
            Itineraries in Lake Geneva, WI, may connect hotels, resorts and event venues downtown and around Geneva Lake. Planning examples include the Riviera Ballroom, Grand Geneva Resort &amp; Spa, The Geneva Inn, Maxwell Mansion, Destination Geneva National and The Abbey Resort in Fontana. A wedding weekend may also include accommodations or scheduled stops near Williams Bay.
          </p>
          <p>
            These names are provided only as route-planning examples; they do not imply a partnership, endorsement, prior booking or guaranteed trolley access. Loading locations, parking, property rules and transportation approval should always be confirmed directly with each venue before the itinerary is finalized.
          </p>
          <a href="https://www.visitlakegeneva.com/weddings/" class="lg-destination__link">Explore official wedding planning resources for Lake Geneva, WI →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="lg-resorts" aria-labelledby="lake-geneva-resorts-title">
    <div class="wrap wrap-1140">
      <header class="lg-resorts__head">
        <div>
          <Eyebrow label="Popular Resorts in Lake Geneva, WI" align="left" single size="sm" mb={17} />
          <h2 id="lake-geneva-resorts-title">Stay together.<br />Ride together.</h2>
        </div>
        <p>
          Wedding weekends in Lake Geneva, WI often unfold across expansive resort properties. Use the resort guide below to identify the exact lodging building, entrance and approved loading point before your trolley schedule is finalized.
        </p>
      </header>

      <div class="lg-resorts__gallery rv" aria-label="Scenes around Geneva Lake">
        <figure class="lg-resorts__photo lg-resorts__photo--main">
          <Image
            src={lakeGenevaResortsImage}
            alt="Autumn trees reflected across Geneva Lake in Wisconsin"
            width={960}
            widths={[480, 720, 960]}
            sizes="(max-width: 640px) calc(100vw - 40px), 61vw"
            format="webp"
            quality={76}
            loading="lazy"
            decoding="async"
            class="lg-resorts__photo-image"
          />
          <figcaption>Autumn across Geneva Lake</figcaption>
        </figure>

        <figure class="lg-resorts__photo">
          <Image
            src={lakeGenevaDockAtDusk}
            alt="Lake Geneva, WI waterfront and boat docks illuminated at dusk"
            width={720}
            widths={[360, 540, 720]}
            sizes="(max-width: 640px) 50vw, 32vw"
            format="webp"
            quality={74}
            loading="lazy"
            decoding="async"
            class="lg-resorts__photo-image"
          />
          <figcaption>Waterfront at dusk</figcaption>
        </figure>

        <figure class="lg-resorts__photo">
          <Image
            src={lakeGenevaMansionAutumn}
            alt="Lakeside mansion surrounded by autumn trees near Geneva Lake"
            width={720}
            widths={[360, 540, 720]}
            sizes="(max-width: 640px) 50vw, 32vw"
            format="webp"
            quality={74}
            loading="lazy"
            decoding="async"
            class="lg-resorts__photo-image"
          />
          <figcaption>Lakeside autumn color</figcaption>
        </figure>
      </div>

      <p class="lg-resorts__credit">
        Photography from Lake Geneva, WI by Yinan Chen, public domain via Wikimedia Commons:
        <a href="https://commons.wikimedia.org/wiki/File:Gfp-wisconsin-lake-geneva-across-the-lake.jpg" target="_blank" rel="noopener noreferrer">autumn lake</a>,
        <a href="https://commons.wikimedia.org/wiki/File:Gfp-wisconsin-lake-geneva-at-dusk.jpg" target="_blank" rel="noopener noreferrer">waterfront at dusk</a>, and
        <a href="https://commons.wikimedia.org/wiki/File:Gfp-wisconsin-lake-geneva-mansion-on-the-lake.jpg" target="_blank" rel="noopener noreferrer">lakeside mansion</a>.
      </p>

      <div class="lg-resorts__cards">
        {popularResorts.map((resort, index) => (
          <article class="lg-resort rv">
            <div class="lg-resort__topline">
              <span class="lg-resort__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p class="lg-resort__location">{resort.location}</p>
            </div>
            <h3>{resort.name}</h3>
            <p class="lg-resort__description">{resort.description}</p>
            <div class="lg-resort__footer">
              <p class="lg-resort__note"><strong>Pickup planning</strong>{resort.planningNote}</p>
              <a href={resort.href} class="lg-resort__link" target="_blank" rel="noopener noreferrer">
                Resort details <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="lg-resorts__disclaimer">
        Resorts are included as independent itinerary-planning examples. ChiTown Trolley is not affiliated with or endorsed by these properties, and service is subject to route, access and availability confirmation.
      </p>
    </div>
  </section>

  <section class="lg-faq" aria-labelledby="lake-geneva-faq-title">
    <div class="wrap wrap-860">
      <Eyebrow label="Trolley Questions for Lake Geneva, WI" mb={17} />
      <h2 id="lake-geneva-faq-title">Trolley rental FAQs for Lake Geneva, WI</h2>
      <div class="lg-faq__list" data-lake-geneva-faq>
        {lakeGenevaFaqs.map((item, index) => {
          const buttonId = `lake-geneva-faq-button-${index + 1}`;
          const panelId = `lake-geneva-faq-panel-${index + 1}`;
          return (
            <div class="lg-faq__item">
              <button
                id={buttonId}
                type="button"
                class="lg-faq__head"
                aria-expanded="false"
                aria-controls={panelId}
                data-lake-geneva-faq-toggle
              >
                <span>{item.q}</span>
                <span class="lg-faq__chevron" aria-hidden="true"></span>
              </button>
              <div
                id={panelId}
                class="lg-faq__panel"
                role="region"
                aria-labelledby={buttonId}
              >
                <div class="lg-faq__body" inert>
                  <p>{item.a}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="lg-final">
    <CtaBand
      title="Plan your trolley rental in Lake Geneva, WI"
      sub="Share your event date, group size, pickup location and planned stops for a customized transportation quote."
      ctaLabel="Request a Trolley Quote for Lake Geneva, WI"
      ctaHref={quoteHref}
      secondaryLabel="View the White Trolley"
      secondaryHref={classicTrolleyHref}
    />
  </div>
</BaseLayout>

<style>
  :where(.lg-intro, .lg-itinerary, .lg-resorts, .lg-faq) h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 500;
    line-height: 1.06;
  }

  .lg-hero {
    position: relative;
    display: grid;
    overflow: hidden;
    background: #171717;
    isolation: isolate;
  }
  .lg-hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .lg-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(12, 10, 7, .91) 0%, rgba(12, 10, 7, .78) 42%, rgba(12, 10, 7, .32) 72%, rgba(12, 10, 7, .16) 100%),
      linear-gradient(0deg, rgba(12, 10, 7, .48), transparent 60%);
  }
  .lg-hero__content {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 30px 28px 64px;
  }
  .lg-hero__eyebrow {
    margin: 0 0 18px;
    color: var(--gold-light);
