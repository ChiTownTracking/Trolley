<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');

  if (form) {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.step'));
    const stepByNum = (number: string) => steps.find((step) => step.dataset.step === number);

    const setOpen = (step: HTMLElement, open: boolean) => {
      step.classList.toggle('is-open', open);
      step.querySelector('.step__head')?.setAttribute('aria-expanded', String(open));
      const body = step.querySelector<HTMLElement>('.step__body');
      if (body) body.inert = !open;
    };

    const openStep = (number: string, focus = true) => {
      steps.forEach((step) => setOpen(step, step.dataset.step === number));
      if (focus) {
        const firstControl = stepByNum(number)?.querySelector<HTMLElement>(
          '.step__body .field__control',
        );
        firstControl?.focus({ preventScroll: true });
      }
    };

    const toggleStep = (number: string) => {
      const step = stepByNum(number);
      if (!step) return;
      if (step.classList.contains('is-open')) steps.forEach((item) => setOpen(item, false));
      else openStep(number, false);
    };

    form.querySelectorAll<HTMLElement>('[data-step-toggle]').forEach((button) =>
      button.addEventListener('click', () => toggleStep(button.dataset.stepToggle!)),
    );
    form.querySelectorAll<HTMLElement>('[data-step-next]').forEach((button) =>
      button.addEventListener('click', () => {
        button.closest<HTMLElement>('.step')?.classList.add('is-done');
        openStep(button.dataset.stepNext!);
      }),
    );
    form.querySelectorAll<HTMLElement>('[data-step-back]').forEach((button) =>
      button.addEventListener('click', () => openStep(button.dataset.stepBack!)),
    );

    steps.forEach((step) => setOpen(step, step.classList.contains('is-open')));

    const searchParams = new URLSearchParams(location.search);
    const requestedVehicle = searchParams.get('vehicle');
    if (requestedVehicle) {
      const vehicleSelect = form.querySelector<HTMLSelectElement>('select[name="vehicle"]');
      const matchingOption = vehicleSelect &&
        Array.from(vehicleSelect.options).find((option) => option.text === requestedVehicle);
      if (vehicleSelect && matchingOption) vehicleSelect.value = matchingOption.value;
    }
    const requestedPickup = searchParams.get('pickup');
    if (requestedPickup) {
      const pickupInput = form.querySelector<HTMLInputElement>('input[name="pickup"]');
      if (pickupInput) pickupInput.value = requestedPickup;
    }

    form.addEventListener('netlify-form:success', () => {
      steps.forEach((step) => step.classList.remove('is-done'));
      openStep('1', false);
    });
  }
</script>

<script>
  const lakeGenevaFaq = document.querySelector<HTMLElement>('[data-lake-geneva-faq]');

  if (lakeGenevaFaq) {
    const items = Array.from(lakeGenevaFaq.querySelectorAll<HTMLElement>('.lg-faq__item'));
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item
        .querySelector('[data-lake-geneva-faq-toggle]')
        ?.setAttribute('aria-expanded', String(open));
      const body = item.querySelector<HTMLElement>('.lg-faq__body');
      if (body) body.inert = !open;
    };

    items.forEach((item) => {
      item
        .querySelector<HTMLButtonElement>('[data-lake-geneva-faq-toggle]')
        ?.addEventListener('click', () => {
          const wasOpen = item.classList.contains('is-open');
          items.forEach((otherItem) => setOpen(otherItem, false));
          if (!wasOpen) setOpen(item, true);
        });
      setOpen(item, false);
    });
  }
</script>
