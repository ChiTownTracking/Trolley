---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { Image } from 'astro:assets';
import { fleet } from '../data/fleet';
import type { FleetCategory } from '../data/fleet';
import { withBase } from '../utils/paths';

// Keep the existing fleet order while rendering every vehicle as its own row.
const [fleetFeatured, ...fleetRest] = fleet;
const imageWidths = (width: number, candidates: number[]) => {
  const widths = candidates.filter((candidate) => candidate < width);
  return [...widths, width];
};
const fleetFilters = [
  { value: 'trolley', label: 'Trolley' },
  { value: 'coach-bus', label: 'Coach Bus' },
  { value: 'party-bus', label: 'Party Bus' },
  { value: 'limo-van', label: 'Limo Van' },
] satisfies { value: FleetCategory; label: string }[];
---
<BaseLayout
  title="Our Fleet — ChiTown Trolley"
  description="Classic white trolley, super coach bus, party bus, and executive limo vans — hand-detailed for weddings and events across Chicagoland."
>
  <section class="fleet-heading">
    <Eyebrow label="The Fleet" size="lg" mb={0} />
    <h1 class="fleet-heading__sr-only">Our Fleet</h1>
  </section>

  <div class="fleet-filter wrap wrap-1140">
    <div
      class="fleet-filter__controls"
      role="group"
      aria-label="Fleet categories and Christmas trolley"
      data-fleet-filter-controls
    >
      {fleetFilters.map((filter) => (
        <>
          <button
            class="fleet-filter__button"
            type="button"
            data-fleet-filter={filter.value}
            aria-pressed={filter.value === 'trolley' ? 'true' : 'false'}
          >
            {filter.label}
          </button>
          {filter.value === 'coach-bus' && (
            <a
              class="fleet-filter__button fleet-filter__button--christmas"
              href={withBase('/christmas-trolley')}
            >
              <span class="fleet-filter__christmas">Christmas</span>{' '}
              <span class="fleet-filter__trolley">Trolley</span>
            </a>
          )}
        </>
      ))}
    </div>
    <p
      class="fleet-filter-status"
      data-fleet-filter-status
      role="status"
      aria-live="polite"
    ></p>
  </div>

  <section class="fleet wrap wrap-1140">
    {/* First vehicle — existing markup retained, styled like every fleet row. */}
    <a
      href={withBase(`/fleet/${fleetFeatured.slug}`)}
      class:list={['rv', 'fcard', 'fcard--feature', { 'fcard--image-swap': Boolean(fleetFeatured.hoverImage) }]}
      data-fleet-card
      data-fleet-category={fleetFeatured.category}
    >
      <div class="fcard__media">
        <Image
          src={fleetFeatured.image}
          widths={imageWidths(fleetFeatured.image.width, [384, 480])}
          sizes="(max-width: 640px) calc(100vw - 56px), (max-width: 1140px) 52vw, 590px"
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
          alt={fleetFeatured.name}
          class="fcard__img"
        />
        {fleetFeatured.comingSoon && <span class="fcard__badge">Coming Soon</span>}
        {fleetFeatured.hoverImage && (
          <Image
            src={fleetFeatured.hoverImage}
            widths={imageWidths(fleetFeatured.hoverImage.width, [384, 480])}
            sizes="(max-width: 640px) calc(100vw - 56px), (max-width: 1140px) 52vw, 590px"
            format="webp"
            quality={70}
            loading="lazy"
            decoding="async"
            alt=""
            aria-hidden="true"
            class="fcard__img fcard__img--hover"
          />
        )}
      </div>
      <div class="fcard__body">
        <h2 class="fcard__name">{fleetFeatured.name}</h2>
        <p class="fcard__cap">{fleetFeatured.cap}</p>
        <div class="rule-gold fcard__rule"></div>
        <ul class="fcard__feats">
          {fleetFeatured.feats.map((ft) => (
            <li class="fcard__feat"><span class="fcard__diamond">◆</span>{ft}</li>
          ))}
        </ul>
        <span class="fcard__cta link-gold">View Details →</span>
      </div>
    </a>
    {/* Remaining vehicles retain their canonical order. */}
    {fleetRest.map((fv) => (
      <a
        href={withBase(`/fleet/${fv.slug}`)}
        class:list={['rv', 'fcard', { 'fcard--image-swap': Boolean(fv.hoverImage) }]}
        data-fleet-card
        data-fleet-category={fv.category}
      >
        <div class="fcard__media">
          <Image
            src={fv.image}
            widths={imageWidths(fv.image.width, [320, 480, 640, 800])}
            sizes="(max-width: 820px) calc(100vw - 56px), (max-width: 1140px) 56vw, 620px"
            format="webp"
            quality={70}
            loading="lazy"
            decoding="async"
            alt={fv.name}
            class="fcard__img"
          />
          {fv.comingSoon && <span class="fcard__badge">Coming Soon</span>}
          {fv.hoverImage && (
            <Image
              src={fv.hoverImage}
              widths={imageWidths(fv.hoverImage.width, [320, 480, 640, 800])}
              sizes="(max-width: 820px) calc(100vw - 56px), (max-width: 1140px) 56vw, 620px"
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              alt=""
              aria-hidden="true"
              class="fcard__img fcard__img--hover"
            />
          )}
        </div>
        <div class="fcard__body">
          <h2 class="fcard__name">{fv.name}</h2>
          <p class="fcard__cap">{fv.cap}</p>
          <div class="rule-gold fcard__rule"></div>
          <ul class="fcard__feats">
            {fv.feats.map((ft) => (
              <li class="fcard__feat"><span class="fcard__diamond">◆</span>{ft}</li>
            ))}
          </ul>
          <span class="fcard__cta link-gold">View Details →</span>
        </div>
      </a>
    ))}
  </section>

  <script>
    import '../scripts/fleet-filter';
  </script>
</BaseLayout>

<style>
  .fleet-heading {
    padding: 40px 28px;
    text-align: center;
  }
  .fleet-heading__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .fleet-filter {
    padding: 0 28px 32px;
    text-align: center;
  }
  .fleet-filter__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 28px;
    row-gap: 4px;
  }
  .fleet-filter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 2px 8px;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color .25s ease, color .25s ease;
  }
  .fleet-filter__button:hover {
    border-bottom-color: var(--gold);
    color: var(--gold-deep);
  }
  .fleet-filter__button[aria-pressed='true'] {
    border-bottom-color: var(--gold-dark);
    color: var(--ink);
    font-weight: 600;
  }
  .fleet-filter__button--christmas {
    text-decoration: none;
  }
  .fleet-filter__button--christmas:hover,
  .fleet-filter__button--christmas:focus-visible {
    border-bottom-color: #C8102E;
  }
  .fleet-filter__christmas { color: #00BF4C; }
  .fleet-filter__trolley { color: #C8102E; }
  .fleet-filter-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .fleet {
    padding: 0 28px 40px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .fcard {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, .82fr);
    align-items: stretch;
    gap: clamp(30px, 4vw, 54px);
    padding: 0 0 48px;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    background: transparent;
    color: inherit;
    text-decoration: none;
    box-shadow: none;
    overflow: visible;
    transition: border-color .3s ease;
  }
  .fcard:last-child { border-bottom: 0; }
  .fcard:hover { border-color: var(--gold-light); }
  .fcard__media {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: 100%;
    height: clamp(300px, 30vw, 380px);
    min-height: 0;
    max-height: 380px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cream);
  }
  .fcard__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity .45s ease, transform .6s cubic-bezier(.22, .6, .2, 1);
  }
  .fcard__img--hover {
    opacity: 0;
    transform: scale(1.015);
  }
  .fcard__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, .68);
    border-radius: 999px;
    background: rgba(19, 54, 38, .92);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .17em;
    line-height: 1;
    text-transform: uppercase;
  }
  .fcard:not(.fcard--image-swap):is(:hover, :focus-visible) .fcard__img {
    transform: scale(1.035);
  }
  .fcard--image-swap:is(:hover, :focus-visible) .fcard__img:not(.fcard__img--hover) {
    opacity: 0;
  }
  .fcard--image-swap:is(:hover, :focus-visible) .fcard__img--hover {
    opacity: 1;
    transform: scale(1.035);
  }
  .fcard__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
  }
  .fcard__name {
    margin: 0 0 7px;
    font-family: var(--serif);
    font-size: clamp(31px, 3.2vw, 40px);
    font-weight: 600;
    line-height: 1.05;
  }
  .fcard__cap {
    margin: 0 0 22px;
    color: var(--gold-deep);
    font-size: 12px;
    letter-spacing: .22em;
    text-transform: uppercase;
  }
  .fcard__rule { width: 64px; margin-bottom: 24px; }
  .fcard__feats {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
  }
  .fcard__feat {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.45;
  }
  .fcard__diamond { flex: none; color: var(--gold-dark); font-size: 9px; }
  .fcard__cta {
    align-self: flex-start;
    padding: 11px 18px;
    border: 1px solid var(--gold);
    background: transparent;
    transition: background .25s ease, border-color .25s ease, color .25s ease;
  }
  .fcard:hover .fcard__cta {
    border-color: var(--gold-dark);
    background: var(--gold-cream);
    color: var(--gold-dark);
  }

  @media (max-width: 820px) {
    .fleet { gap: 36px; }
    .fcard,
    .fcard--feature {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 36px;
    }
    .fcard__media,
    .fcard--feature .fcard__media {
      height: auto;
      min-height: 0;
      max-height: none;
      aspect-ratio: 16 / 10;
    }
    .fcard__img,
    .fcard--feature .fcard__img { min-height: 0; }
    .fcard__body,
    .fcard--feature .fcard__body { padding: 28px 4px 0; }
  }
  @media (max-width: 640px) {
    .fleet-filter { padding-bottom: 28px; }
    .fleet-filter__controls { column-gap: 20px; }
    .fleet { gap: 32px; }
    .fcard__body,
    .fcard--feature .fcard__body { padding-top: 24px; }
    .fcard__name { font-size: 31px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fcard__img { transition: none; }
  }
</style>
