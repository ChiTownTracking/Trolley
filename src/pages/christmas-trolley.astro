---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { christmasFaqs } from '../data/site';
import { christmasDecor } from '../data/christmas-images';
import { withBase } from '../utils/paths';
import christmasHeaderBackground from '../assets/images/christmas/gallery/christmas-header-bg.png';
import christmasTrolleyFeatureImage from '../assets/images/christmas/gallery/christmas-trolley.png';

// Dedicated Christmas header artwork.
const heroImage = christmasHeaderBackground;

// Matches the "Choose Vehicle" option so the quote form pre-selects it.
const quoteHref = withBase(`/?vehicle=${encodeURIComponent('Christmas Trolley')}#getquote`);

// Restrained decor accents — transparent garland/wreath cutouts imported
// explicitly from the Christmas image data module.
const featureList = [
  'BYOB private trolley tours',
  'Seats 24 to 36 guests',
  'Circular perimeter seating',
  'Enclosed and heated trolley',
  'Premium Bluetooth sound system',
  'Rear balcony platform for photos',
  'Christmas lights inside and out',
  'Limited seasonal availability — book early',
];
---
<BaseLayout
  title="Chicago Christmas Trolley Tours | ChiTown Trolley"
  description="Book a private Chicago Christmas trolley tour for holiday lights, family outings and group celebrations. Heated, BYOB and available across Chicagoland."
  hideCta={true}
>
  <!-- ═══ Festive hero ═══ -->
  <section class="xhero" style={`background-image: url('${heroImage.src}')`}>
    <div class="xhero__lights" aria-hidden="true"></div>
    <div class="xhero__overlay"></div>
    <div class="xhero__content">
      <p class="xhero__kicker">A ChiTown Trolley Holiday Tradition</p>
      <h1 class="xhero__title">Chicago Christmas Trolley Tours</h1>
      <p class="xhero__lead">Private holiday lights tours for groups across Chicago and Chicagoland—heated, BYOB and reserved for your evening.</p>
      <a href={quoteHref} class="btn-gold xhero__cta">Christmas Trolley Quote</a>
    </div>
  </section>

  <!-- ═══ What's included ═══ -->
  <section class="rv xfeat">
    <div class="xfeat__inner wrap wrap-1140">
      <div class="xfeat__photo">
        <Image
          src={christmasTrolleyFeatureImage}
          alt="White Christmas trolley illuminated with colorful roofline lights"
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 860px) calc(100vw - 56px), 52vw"
          format="webp"
          quality={86}
          class="xfeat__img"
          loading="lazy"
        />
      </div>
      <div class="xfeat__list">
        <Eyebrow label="Private Christmas Trolley Tour" align="left" mb={14} />
        <h2 class="xfeat__title">Everything the season <em class="grad">calls for</em></h2>
        <ul class="xfeat__items">
          {featureList.map((f, i) => (
            <li class="xfeat__item">
              <span class="xicon" aria-hidden="true">
                {i % 3 === 0 && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M12 2v20M4 6l16 12M20 6L4 18M12 5l-2.5-2M12 5l2.5-2M12 19l-2.5 2M12 19l2.5 2M6.2 7.6l-3.2.9M6.2 16.4l-3.2-.9M17.8 7.6l3.2.9M17.8 16.4l3.2-.9"/></svg>
                )}
                {i % 3 === 1 && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13.5" r="7"/><path d="M10 6.5V4.8c0-.5.4-.8.9-.8h2.2c.5 0 .9.3.9.8v1.7M9 11c1 1 5 1 6 0"/></svg>
                )}
                {i % 3 === 2 && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="12" rx="1"/><path d="M4 13h16M12 9v12M12 9s-4 0-5.2-1.6C5.6 5.8 7 4 8.6 4.6 10.4 5.3 12 9 12 9Zm0 0s4 0 5.2-1.6C18.4 5.8 17 4 15.4 4.6 13.6 5.3 12 9 12 9Z"/></svg>
                )}
              </span>
              <span class:list={['xfeat__text', { 'xfeat__text--note': i === featureList.length - 1 }]}>{f}</span>
            </li>
          ))}
        </ul>
        <a href={quoteHref} class="btn-gold xfeat__cta">Christmas Trolley Quote</a>
      </div>
    </div>
  </section>

  <!-- ═══ Seasonal narrative ═══ -->
  <section class="rv xstory wrap wrap-760">
    <Eyebrow label="Private Holiday Lights Tour" mb={20} />
    <h2 class="h-section xstory__title">Plan a Christmas lights route for your group</h2>
    <div class="xstory__body">
      <p>
        As dusk settles over the neighborhoods, the trolley glows to life with lights tracing the roofline, holiday decorations inside the cabin and heat against the December air. Your group can enjoy its own playlist through the Bluetooth sound system while <em>traveling together between displays and planned stops</em>.
      </p>
      <p>
        Share your pickup location, preferred neighborhoods and any stops you would like to include. The final route will depend on your reservation length, traffic, vehicle access and confirmed service area. When the right block of lights appears, the <em>rear balcony provides a memorable place for group photos</em>.
      </p>
    </div>
  </section>

  <!-- ═══ Christmas FAQs ═══ -->
  <section class="rv faq" aria-labelledby="christmas-faq-title">
    <div class="wrap wrap-860">
      <Eyebrow label="Christmas Trolley Questions" mb={16} />
      <h2 id="christmas-faq-title" class="h-section text-center faq__title">Chicago Christmas trolley FAQs</h2>
      <div class="faq__list" data-faq>
        {christmasFaqs.map((item, i) => {
          const buttonId = `christmas-faq-button-${i + 1}`;
          const panelId = `christmas-faq-panel-${i + 1}`;
          return (
            <div class="faq__item">
              <button
                id={buttonId}
                type="button"
                class="faq__head"
                aria-expanded="false"
                aria-controls={panelId}
                data-faq-toggle
              >
                <span class="faq__q">{item.q}</span>
                <span class="faq__chev" aria-hidden="true"></span>
              </button>
              <div
                id={panelId}
                class="faq__panel"
                role="region"
                aria-labelledby={buttonId}
              >
                <div class="faq__body" inert>
                  <p class="faq__a">{item.a}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══ Festive CTA band ═══ -->
  <div class="xcta-wrap">
    <div class="xcta-wrap__garland" style={`--decor-img: url('${christmasDecor.garlandStripBottom.src}')`} aria-hidden="true"></div>
    <CtaBand
      title="Reserve your Chicago Christmas trolley"
      sub="Seasonal dates fill quickly. Share your group size, pickup location and preferred evening to request availability."
      ctaLabel="Christmas Trolley Quote"
      ctaHref={quoteHref}
    />
  </div>
</BaseLayout>

<style>
  /* Text accents lean into real Christmas red/green — the same #00BF4C /
     #C8102E used on the "Christmas Trolley" nav link — layered over the
     site's black/gold. Gold is kept on the signature script headlines and
     the primary buttons so the page still reads as the same brand. */

  /* ── Hero ─────────────────────────────────────────────── */
  .xhero {
    position: relative;
    height: 315px;
    overflow: hidden;
    background-color: #0E1524;
    background-size: cover;
    background-position: center 22%;
  }
  /* A string of small red/green bulbs along the hero's top edge, blinking
     out of phase (red bright while green dims, and vice versa) — a CSS-only
     stand-in for string lights, no image asset required. */
  .xhero__lights {
    position: absolute; top: 0; left: 0; right: 0; z-index: 3;
    height: clamp(24px, 3.4vw, 34px);
    pointer-events: none;
  }
  .xhero__lights::before,
  .xhero__lights::after {
    content: ''; position: absolute; top: 7px; left: 0; right: 0; height: 12px;
    background-repeat: repeat-x;
    background-size: 64px 12px;
  }
  .xhero__lights::before {
    background-image: radial-gradient(
      circle 3px at 8px 6px,
      #ff6b6b 0%, #d21f3c 50%, rgba(210, 31, 60, .35) 68%, transparent 78%
    );
    animation: xblink-red 1.7s ease-in-out infinite;
  }
  .xhero__lights::after {
    background-image: radial-gradient(
      circle 3px at 40px 6px,
      #7be89a 0%, #1f8a4c 50%, rgba(31, 138, 76, .35) 68%, transparent 78%
    );
    animation: xblink-green 1.7s ease-in-out infinite;
  }
  @keyframes xblink-red { 0%, 40% { opacity: 1; } 50%, 90% { opacity: .3; } 100% { opacity: 1; } }
  @keyframes xblink-green { 0%, 40% { opacity: .3; } 50%, 90% { opacity: 1; } 100% { opacity: .3; } }
  .xhero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 11, 20, .84) 0%,
      rgba(8, 11, 20, .6) 34%,
      rgba(8, 11, 20, .22) 62%,
      rgba(8, 11, 20, .05) 85%
    );
  }
  .xhero__content {
    position: relative; z-index: 2; height: 100%;
    max-width: 1400px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
    gap: 15px; padding: clamp(24px, 4vw, 30px) clamp(24px, 6vw, 96px) 0;
    animation: fadeInUp 1.1s cubic-bezier(.22, .6, .2, 1) both;
  }
  .xhero__kicker {
    font-size: 11px; letter-spacing: .34em; text-transform: uppercase;
    color: var(--gold-light); margin: 0;
  }
  .xhero__title {
    font-family: var(--serif); font-weight: 500; color: #fff;
    font-size: clamp(36px, 5.4vw, 70px); line-height: 1.1; margin: 0;
    text-shadow: 0 2px 26px rgba(0, 0, 0, .45);
  }
  .xhero__lead {
    font-weight: 300; font-size: 16.5px; letter-spacing: .02em;
    color: rgba(253, 252, 250, .88); max-width: 46ch; line-height: 1.7; margin: 0 0 8px;
  }
  .xhero__cta { padding: 12px 24px; font-size: 11px; }

  /* ── What's included ─────────────────────────────────── */
  .xfeat { position: relative; }
  .xfeat__inner {
    padding: 40px 28px 70px 28px;
    display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .xfeat__photo { overflow: hidden; border-radius: 8px; }
  .xfeat__img {
    width: 100%; height: auto; display: block;
  }
  .xfeat__title { font-family: var(--serif); font-size: clamp(27px, 3vw, 36px); font-weight: 600; line-height: 1.2; margin: 0 0 18px; }
  .xfeat__items { list-style: none; margin: 0 0 34px; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .xfeat__item { display: flex; align-items: center; gap: 14px; }
  /* Eyebrow above the feature list — red, to lead with the Christmas theme. */
  .xfeat :global(.eyebrow__label) { color: #C8102E; }
  .xfeat :global(.eyebrow__rule) {
    background: linear-gradient(90deg, transparent, #C8102E);
  }
  .xfeat :global(.eyebrow__rule--r) {
    background: linear-gradient(90deg, #C8102E, transparent);
    display: none;
  }
  .xicon { flex: none; width: 22px; height: 22px; color: var(--gold-dark); }
  .xicon svg { width: 100%; height: 100%; }
  /* Icons cycle gold → green → red so the seasonal palette reads as real
     accent color, not just a single exception at the end. */
  .xfeat__item:nth-child(3n+2) .xicon { color: #00BF4C; }
  .xfeat__item:nth-child(3n+3) .xicon { color: #C8102E; }
  .xfeat__text { font-weight: 300; font-size: 15px; color: var(--muted); }
  /* The scarcity note gets a Christmas-red emphasis */
  .xfeat__text--note { color: #C8102E; font-weight: 400; }
  .xfeat__item:last-child .xicon { color: #C8102E; }
  .xfeat__cta { align-self: flex-start; }

  /* ── Narrative ───────────────────────────────────────── */
  .xstory { padding: 50px 28px 72px; text-align: center; }
  .xstory :global(.eyebrow__label) { color: #C8102E; }
  .xstory__title { margin: 0 0 28px; }
  .xstory__body {
    font-family: var(--serif); font-size: 21px; line-height: 1.65;
    font-weight: 400; color: var(--ink); text-align: left;
  }
  .xstory__body p { margin: 0; }
  .xstory__body p + p { margin-top: 22px; }
  .xstory__body em { color: #00BF4C; }

  /* ── FAQ accordion (matches the homepage pattern) ───── */
  .faq { background: var(--cream); padding: 56px 28px 72px; }
  .faq :global(.eyebrow__label) { color: #C8102E; }
  .faq__title { margin: 0 auto 34px; }
  .faq__list { max-width: 800px; margin: 0 auto; }
  .faq__item { border-top: 1px solid var(--line-2); }
  .faq__item:last-child { border-bottom: 1px solid var(--line-2); }
  .faq__head {
    width: 100%; display: flex; align-items: center; gap: 20px;
    padding: 24px 4px; background: transparent; border: 0; cursor: pointer;
    text-align: left; font-family: var(--serif); color: var(--ink);
  }
  .faq__head:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: 4px; }
  .faq__q { flex: 1; font-size: 20px; font-weight: 600; line-height: 1.35; }
  .faq__chev {
    flex: none; width: 10px; height: 10px;
    border-right: 1.5px solid var(--gold-deep); border-bottom: 1.5px solid var(--gold-deep);
    transform: translateY(-2px) rotate(45deg); transition: transform .3s ease;
  }
  .faq__item.is-open .faq__chev { transform: translateY(2px) rotate(-135deg); }
  .faq__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }
  .faq__body { overflow: hidden; min-height: 0; }
  .faq__a {
    margin: 0; padding: 0 4px 26px; max-width: 66ch;
    color: var(--muted); font-size: 15px; font-weight: 300; line-height: 1.8;
  }

  /* ── Festive CTA garland (bookends the hero treatment) ── */
  .xcta-wrap { position: relative; }
  .xcta-wrap__garland {
    position: absolute; top: -6px; left: 0; right: 0; z-index: 2;
    height: clamp(48px, 7vw, 84px);
    background-image: var(--decor-img);
    background-repeat: repeat-x; background-position: top center; background-size: auto 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    pointer-events: none;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 860px) {
    .xfeat__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .xfeat__list { display: contents; }
    .xfeat__list :global(.eyebrow) {
      order: 1;
      justify-content: center;
    }
    .xfeat__list :global(.eyebrow__rule--r) { display: block; }
    .xfeat__title {
      order: 2;
      text-align: center;
    }
    .xfeat__photo { order: 3; margin-bottom: 28px; }
    .xfeat__items { order: 4; }
    .xfeat__cta { order: 5; }
  }
  @media (max-width: 640px) {
    .xhero { height: 280px; }
    .xhero__overlay {
      background: linear-gradient(90deg, rgba(8, 11, 20, .88) 0%, rgba(8, 11, 20, .68) 55%, rgba(8, 11, 20, .42) 100%);
    }
    .xhero__lights { height: clamp(20px, 5vw, 28px); }
    .xhero__content {
      gap: 10px;
      padding: 18px 18px 0;
    }
    .xhero__kicker { font-size: 9px; letter-spacing: .25em; }
    .xhero__title { font-size: clamp(28px, 9vw, 40px); line-height: 1.05; }
    .xhero__lead { max-width: 40ch; font-size: 12.5px; line-height: 1.45; margin-bottom: 2px; }
    .xhero__cta {
      min-height: 30px;
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      font-size: 9.25px;
      letter-spacing: .16em;
    }
    .xstory__body { font-size: 20px; }
    .faq { padding: 48px 22px 60px; }
    .faq__q { font-size: 17px; }
    .faq__head { gap: 14px; padding: 20px 2px; }
    .xcta-wrap__garland { height: clamp(34px, 8vw, 48px); }
    /* Kept at 44px (not shrunk) — that's the tap-target minimum. */
  }
  @media (max-width: 481px) {
    .xfeat :global(.eyebrow__label),
    .xstory :global(.eyebrow__label),
    .faq :global(.eyebrow__label) {
      font-size: 9px !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .xhero__lights::before, .xhero__lights::after { animation: none; opacity: .85; }
    .faq__panel, .faq__chev { transition: none; }
  }
</style>

<script>
  // FAQ accordion — one item open at a time, matching the homepage behavior.
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    const items = Array.from(faq.querySelectorAll<HTMLElement>('.faq__item'));
    const setFaqOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('[data-faq-toggle]')?.setAttribute('aria-expanded', String(open));
      const body = item.querySelector<HTMLElement>('.faq__body');
      if (body) body.inert = !open;
    };

    items.forEach((item) => {
      item.querySelector<HTMLButtonElement>('[data-faq-toggle]')?.addEventListener('click', () => {
        const wasOpen = item.classList.contains('is-open');
        items.forEach((otherItem) => setFaqOpen(otherItem, false));
        if (!wasOpen) setFaqOpen(item, true);
      });
      setFaqOpen(item, false);
    });
  }
</script>
