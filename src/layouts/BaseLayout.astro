---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import type { ImageMetadata } from 'astro';
import jostNormalUrl from '../assets/fonts/jost/jost-latin-variable-normal.woff2?url';
import cormorantNormalUrl from '../assets/fonts/cormorant-garamond/cormorant-garamond-latin-variable-normal.woff2?url';
import cormorantItalicUrl from '../assets/fonts/cormorant-garamond/cormorant-garamond-latin-variable-italic.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Hide the gold CTA band above the footer (e.g. on Contact/Reservation). */
  hideCta?: boolean;
  /** Root-relative or absolute og:image (e.g. an article's cover photo). */
  image?: string | ImageMetadata;
  /** og:type — pages like guide articles should pass 'article'. */
  ogType?: 'website' | 'article';
  /** Optional crawler directive for confirmed draft/utility pages. */
  robots?: 'index,follow' | 'noindex,follow';
  /** Utility pages such as the 404 should not advertise a nonexistent canonical route. */
  omitCanonical?: boolean;
  /** Optional JSON-LD object(s) injected as a <script type="application/ld+json">. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Homepage hero preload URLs, split by viewport. */
  mobileHeroPreload?: string;
  desktopHeroPreload?: string;
  /** Disable only on routes whose initial viewport has no italic serif text. */
  preloadSerifItalic?: boolean;
}

const {
  title = `${site.name} — Chicago Wedding Trolley Transportation`,
  description = site.description,
  hideCta = false,
  image,
  ogType = 'website',
  robots,
  omitCanonical = false,
  schema,
  mobileHeroPreload,
  desktopHeroPreload,
  preloadSerifItalic = true,
} = Astro.props;

const canonical = new URL(withBase(Astro.url.pathname), Astro.site ?? Astro.url).href;
const imagePath = typeof image === 'string' ? withBase(image) : image?.src;
const ogImage = imagePath ? new URL(imagePath, Astro.site ?? Astro.url).href : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>document.documentElement.classList.add('reveal-ready');</script>
  <title>{title}</title>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18375745058"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', 'AW-18375745058');
  </script>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  {!omitCanonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={ogType} />
  {!omitCanonical && <meta property="og:url" content={canonical} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#FDFCFA" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  <link rel="icon" href={withBase('/favicon_io/favicon.ico')} sizes="any" />
  <link rel="icon" href={withBase('/favicon_io/favicon-32x32.png')} type="image/png" sizes="32x32" />
  <link rel="icon" href={withBase('/favicon_io/favicon-16x16.png')} type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href={withBase('/favicon_io/apple-touch-icon.png')} sizes="180x180" />
  <link rel="manifest" href={withBase('/favicon_io/site.webmanifest')} />
  <link rel="preload" href={jostNormalUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href={cormorantNormalUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  {preloadSerifItalic && (
    <link rel="preload" href={cormorantItalicUrl} as="font" type="font/woff2" crossorigin="anonymous" />
  )}
  {mobileHeroPreload && (
    <link
      rel="preload"
      as="image"
      href={mobileHeroPreload}
      type="image/webp"
      media="(max-width: 768px)"
      fetchpriority="high"
    />
  )}
  {desktopHeroPreload && (
    <link
      rel="preload"
      as="image"
      href={desktopHeroPreload}
      type="image/webp"
      media="(min-width: 769px)"
      fetchpriority="high"
    />
  )}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="site">
    <TopBar />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!hideCta && <CtaBand />}
    <Footer />
  </div>

  <dialog
    class="form-success-popup"
    data-form-success-popup
    aria-labelledby="form-success-title"
    aria-describedby="form-success-message"
  >
    <div class="form-success-popup__panel">
      <button
        type="button"
        class="form-success-popup__close"
        data-form-success-popup-close
        aria-label="Close confirmation"
      >
        ×
      </button>
      <span class="form-success-popup__icon" aria-hidden="true">✓</span>
      <p class="form-success-popup__eyebrow">Submission received</p>
      <p class="form-success-popup__title" id="form-success-title">Thank you!</p>
      <p id="form-success-message" data-form-success-popup-message>
        Your request has been submitted successfully.
      </p>
      <button type="button" class="btn-gold" data-form-success-popup-close>Close</button>
    </div>
  </dialog>

  <script>
    // Reveal-on-scroll for any .rv element on the page.
    const reveal = () => {
      const els = document.querySelectorAll<HTMLElement>('.rv:not(.in)');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
      );
      els.forEach((el) => io.observe(el));
    };
    reveal();
  </script>
  <script>
    import '../scripts/netlify-forms';
  </script>
</body>
</html>
