---
import { withBase } from '../utils/paths';

/**
 * Persistent quote CTA pinned to the bottom-right corner on every page.
 * Points at the homepage quote form, the same destination as the CTA band.
 */
---
<a
  class="fq"
  href={withBase('/#getquote')}
  data-floating-quote
>
  <svg
    class="fq__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
  </svg>
  <span class="fq__label">Get Quote</span>
</a>

<style>
  .fq {
    position: fixed;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    /* Under the sticky header (60) and far under the open mobile drawer (900). */
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border: none;
    border-radius: 999px;
    background: var(--grad-gold);
    box-shadow: 0 6px 22px rgba(26, 26, 26, .22);
    color: #000;
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: .2em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: box-shadow .3s ease, transform .3s ease;
  }
  .fq:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(184, 134, 11, .45);
  }
  .fq:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 4px;
  }
  .fq__icon {
    width: 16px;
    height: 16px;
    flex: none;
  }

  /* The drawer takes over the screen on mobile — don't float above it. */
  :global(html.menu-open) .fq {
    opacity: 0;
    pointer-events: none;
  }

  /* Phones: an icon-only tap target, so it never crowds the content. */
  @media (max-width: 600px) {
    .fq {
      gap: 0;
      width: 54px;
      height: 54px;
      padding: 0;
      justify-content: center;
    }
    .fq__icon { width: 21px; height: 21px; }
    .fq__label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fq { transition: none; }
    .fq:hover { transform: none; }
  }
</style>
