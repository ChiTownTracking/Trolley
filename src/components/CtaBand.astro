---
import { site } from '../data/site';
import { withBase } from '../utils/paths';

/** Optional overrides — defaults keep the site-wide band unchanged. */
interface Props {
  title?: string;
  sub?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  eyebrow?: string;
  variant?: 'gold' | 'dark';
}
const {
  title = "Your date won't wait — let's hold it",
  sub = `Call ${site.contact.phoneDisplay} or request a quote in under two minutes.`,
  ctaLabel = 'Get a Free Quote',
  ctaHref = '/#getquote',
  secondaryLabel,
  secondaryHref,
  eyebrow,
  variant = 'gold',
} = Astro.props;
---
<section class:list={['rv', 'cta-band', `cta-band--${variant}`]}>
  <div class="cta-band__inner">
    <div class="cta-band__copy">
      {eyebrow && <p class="cta-band__eyebrow">{eyebrow}</p>}
      <h2 class="cta-band__title">{title}</h2>
      <p class="cta-band__sub">{sub}</p>
    </div>
    <div class="cta-band__actions">
      <a
        href={withBase(ctaHref)}
        class:list={[variant === 'dark' ? 'btn-gold' : 'btn-invert', 'cta-band__primary']}
      >
        {ctaLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={withBase(secondaryHref)} class="cta-band__secondary">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--grad-gold);
    padding: 50px 28px;
    text-align: center;
  }
  .cta-band__inner {
    max-width: 1180px;
    margin: 0 auto;
  }
  .cta-band__eyebrow {
    margin: 0 0 14px;
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .28em;
    text-transform: uppercase;
  }
  .cta-band__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 42px);
    color: var(--paper);
    margin: 0 0 10px;
  }
  .cta-band__sub {
    font-weight: 300;
    font-size: 15px;
    color: rgba(253, 252, 250, .85);
    margin: 0 0 32px;
    letter-spacing: .04em;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .cta-band__secondary {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 14px 30px;
    color: var(--paper) !important;
    border: 1px solid rgba(253, 252, 250, .72);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .18em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition: background 220ms ease, border-color 220ms ease;
  }
  .cta-band__secondary svg {
    width: 16px;
    height: 16px;
    flex: none;
    margin-right: 10px;
  }
  .cta-band__secondary:hover {
    background: rgba(253, 252, 250, .12);
    border-color: var(--paper);
  }
  .cta-band--dark {
    position: relative;
    padding-block: 66px;
    overflow: hidden;
    background: #171717;
    border-top: 1px solid rgba(212, 175, 106, .7);
    text-align: left;
  }
  .cta-band--dark::after {
    content: '';
    position: absolute;
    top: -160px;
    right: -90px;
    width: 430px;
    height: 430px;
    border: 1px solid rgba(212, 175, 106, .14);
    border-radius: 50%;
    box-shadow:
      0 0 0 54px rgba(212, 175, 106, .035),
      0 0 0 108px rgba(212, 175, 106, .02);
    pointer-events: none;
  }
  .cta-band--dark .cta-band__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    align-items: center;
    gap: clamp(44px, 8vw, 100px);
  }
  .cta-band--dark .cta-band__title {
    max-width: 760px;
    margin-bottom: 12px;
    font-size: clamp(34px, 4.2vw, 50px);
    line-height: 1.04;
  }
  .cta-band--dark .cta-band__sub {
    max-width: 64ch;
    margin: 0;
    color: rgba(253, 252, 250, .72);
    line-height: 1.7;
  }
  .cta-band--dark .cta-band__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .cta-band--dark .cta-band__primary,
  .cta-band--dark .cta-band__secondary {
    width: 100%;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    box-sizing: border-box;
  }
  .cta-band--dark .cta-band__secondary {
    border-color: rgba(212, 175, 106, .7);
    color: var(--gold-light) !important;
  }
  .cta-band--dark .cta-band__secondary:hover {
    border-color: var(--gold-light);
    background: rgba(212, 175, 106, .09);
  }

  @media (max-width: 760px) {
    .cta-band--dark {
      padding: 56px 22px;
      text-align: center;
    }
    .cta-band--dark .cta-band__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cta-band--dark .cta-band__sub {
      margin-inline: auto;
    }
    .cta-band--dark .cta-band__actions {
      width: min(100%, 360px);
      margin-inline: auto;
    }
  }

  @media (max-width: 520px) {
    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-band__actions :global(a) {
      width: 100%;
      min-height: 46px;
      padding-inline: 18px;
    }
    .cta-band--dark .cta-band__title {
      font-size: clamp(31px, 9vw, 40px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-band__secondary {
      transition: none;
    }
  }
</style>
