---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../utils/paths';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
}

const {
  eyebrow,
  title,
  body,
  image,
  imageAlt,
  href,
} = Astro.props;
---
<article class="service-card">
  <div class="service-card__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[360, 540, 720]}
      sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 980px) calc(50vw - 42px), 370px"
      format="webp"
      quality={82}
      class="service-card__image"
      loading="lazy"
    />
  </div>
  <div class="service-card__content">
    <p class="service-card__eyebrow">{eyebrow}</p>
    <h3 class="service-card__title">{title}</h3>
    <p class="service-card__body">{body}</p>
    <a
      href={withBase(href)}
      class="service-card__link"
      aria-label={`Learn more about ${title}`}
    >
      Learn More <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .service-card {
    min-width: 0;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 8px 26px rgba(23, 23, 23, .055);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold-light);
    box-shadow: 0 18px 42px rgba(23, 23, 23, .11);
  }
  .service-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--cream);
  }
  .service-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 220ms ease;
  }
  .service-card:hover .service-card__image {
    transform: scale(1.025);
  }
  .service-card__content {
    display: flex;
    min-height: 286px;
    flex-direction: column;
    padding: 26px 26px 28px;
  }
  .service-card__eyebrow {
    margin: 0 0 12px;
    color: var(--gold-deep);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .service-card__title {
    margin: 0 0 12px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 600;
    line-height: 1.16;
  }
  .service-card__body {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.7;
  }
  .service-card__link {
    width: fit-content;
    margin-top: auto;
    padding-block: 8px;
    color: var(--gold-deep);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .18em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .service-card__link span {
    display: inline-block;
    margin-left: 5px;
    transition: transform 200ms ease;
  }
  .service-card__link:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .service-card__content {
      min-height: 0;
      padding: 23px 22px 25px;
    }
    .service-card__title {
      font-size: 24px;
    }
    .service-card__link {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card__image,
    .service-card__link span {
      transition: none;
    }
  }
</style>
