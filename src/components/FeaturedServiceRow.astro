---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Eyebrow from './Eyebrow.astro';
import { withBase } from '../utils/paths';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
  benefits: readonly string[];
  ctaLabel: string;
  ctaHref: string;
  reverse?: boolean;
}

const {
  id,
  eyebrow,
  title,
  body,
  image,
  imageAlt,
  benefits,
  ctaLabel,
  ctaHref,
  reverse = false,
} = Astro.props;
---
<article id={id} class:list={['featured-service', { 'featured-service--reverse': reverse }]}>
  <div class="featured-service__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 820px) calc(100vw - 40px), (max-width: 1400px) 47vw, 650px"
      format="webp"
      quality={84}
      class="featured-service__image"
      loading="lazy"
    />
  </div>
  <div class="featured-service__content">
    <Eyebrow label={eyebrow} align="left" single size="xs" mb={16} />
    <h3 class="featured-service__title">{title}</h3>
    <p class="featured-service__body">{body}</p>
    <ul class="featured-service__benefits">
      {benefits.map((benefit) => (
        <li>
          <span aria-hidden="true"></span>
          {benefit}
        </li>
      ))}
    </ul>
    <a href={withBase(ctaHref)} class="btn-ghost">{ctaLabel}</a>
  </div>
</article>

<style>
  .featured-service {
    display: grid;
    min-height: 360px;
    grid-template-columns: minmax(0, 47fr) minmax(0, 53fr);
    align-items: stretch;
    border-top: 1px solid rgba(184, 134, 11, .24);
    scroll-margin-top: calc(var(--nav-h, 80px) + 24px);
  }
  .featured-service:first-child {
    border-top: 0;
  }
  .featured-service:nth-child(even) {
    background: #f8f4ec;
  }
  .featured-service--reverse .featured-service__media {
    order: 2;
  }
  .featured-service--reverse .featured-service__content {
    order: 1;
  }
  .featured-service__media {
    align-self: center;
    width: 100%;
    height: clamp(340px, 30vw, 390px);
    min-height: 0;
    overflow: hidden;
    background: var(--cream);
  }
  .featured-service__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .featured-service__content {
    display: flex;
    max-width: 620px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 38px clamp(38px, 5vw, 74px);
  }
  .featured-service__title {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(29px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.1;
  }
  .featured-service__body {
    margin: 17px 0 0;
    color: var(--muted);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.72;
  }
  .featured-service__benefits {
    display: grid;
    gap: 8px;
    margin: 20px 0 24px;
    padding: 0;
    list-style: none;
  }
  .featured-service__benefits li {
    display: flex;
    align-items: baseline;
    gap: 11px;
    color: var(--ink);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .featured-service__benefits span {
    width: 5px;
    height: 5px;
    flex: none;
    transform: rotate(45deg);
    background: var(--gold-dark);
  }
  .featured-service .btn-ghost {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    font-size: 10.5px;
    letter-spacing: .16em;
    line-height: 1.35;
    text-align: center;
  }

  @media (max-width: 1040px) {
    .featured-service {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    }
    .featured-service__content {
      padding: 34px clamp(28px, 4vw, 48px);
    }
    .featured-service__title {
      font-size: clamp(28px, 3.4vw, 36px);
    }
  }

  @media (max-width: 820px) {
    .featured-service {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .featured-service--reverse .featured-service__media,
    .featured-service--reverse .featured-service__content {
      order: initial;
    }
    .featured-service__media {
      height: clamp(240px, 50vw, 330px);
      min-height: 0;
      max-height: none;
    }
    .featured-service__content {
      max-width: 650px;
      padding: 34px 30px 42px;
    }
  }

  @media (max-width: 520px) {
    .featured-service__content {
      padding: 30px 20px 38px;
    }
    .featured-service__title {
      font-size: clamp(28px, 8.6vw, 36px);
    }
    .featured-service__body {
      font-size: 15px;
    }
    .featured-service .btn-ghost {
      width: 100%;
      padding-inline: 18px;
    }
  }

  @media (max-width: 360px) {
    .featured-service__content {
      padding-inline: 16px;
    }
    .featured-service .btn-ghost {
      font-size: 10px;
      letter-spacing: .13em;
    }
  }
</style>
